+.chip { background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; cursor: pointer; }
+.chip.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
+.card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; }
+.card.unread { border-color: var(--accent); }
+.card h2 { margin: 0; font-size: 15px; color: var(--accent); }
+.card p { margin: 0; }
+.row { display: flex; gap: 14px; align-items: flex-start; }
+.row time { min-width: 96px; color: var(--muted); font-variant-numeric: tabular-nums; }
+.row small { display: block; color: var(--muted); }
+
+@media (max-width: 760px) {
+  .cols { grid-template-columns: 1fr; gap: 28px; }
+  .title { font-size: 34px; }
