+.link { display: flex; align-items: center; gap: 10px; border: 0; background: none; padding: 0; text-align: left; font-weight: 700; font-size: 17px; cursor: pointer; }
+.link .txt { border-bottom: 1.5px solid var(--line); }
+.link:hover:not(:disabled) .txt { border-bottom-color: var(--ink); }
+.link small { color: var(--muted); font-weight: 400; font-size: 13px; }
+.link:disabled { color: var(--muted); cursor: default; }
+.link:disabled .txt { border-bottom-color: transparent; }
+.ic { position: relative; width: 26px; font-size: 19px; line-height: 1; }
+.ic::after { content: '↗'; position: absolute; right: -3px; bottom: -6px; font-size: 11px; font-weight: 900; line-height: 1; color: var(--ink); background: var(--panel); border-radius: 3px; }
+.link:disabled .ic::after { display: none; }
+
+/* 일정·메일 하위 화면 */
+.subpage { min-height: 100%; display: flex; flex-direction: column; }
+.subbody { width: min(900px, 100%); margin: 0 auto; padding: 20px; display: flex; flex-direction: column; gap: 12px; }
