--- /dev/null
+++ b/backend/test/unit/crypto.spec.ts
@@ -0,0 +1,27 @@
+import { decrypt, encrypt } from '../../src/common/crypto';
+
+const KEY = 'a'.repeat(64);
+
+describe('crypto', () => {
+  it('암호화 후 복호화', () => {
+    expect(decrypt(encrypt('refresh-token', KEY), KEY)).toBe('refresh-token');
+  });
+
+  it('같은 평문도 매번 다른 암호문', () => {
+    expect(encrypt('x', KEY)).not.toBe(encrypt('x', KEY));
+  });
+
+  it('다른 키면 실패', () => {
+    expect(() => decrypt(encrypt('x', KEY), 'b'.repeat(64))).toThrow();
+  });
+
+  it('변조되면 실패', () => {
+    const buf = Buffer.from(encrypt('secret', KEY), 'base64');
+    buf[buf.length - 1] ^= 1;
+    expect(() => decrypt(buf.toString('base64'), KEY)).toThrow();
+  });
+
+  it('키 길이가 32바이트가 아니면 실패', () => {
+    expect(() => encrypt('x', 'abcd')).toThrow(/32 bytes/);
+  });
+});
diff --git a/backend/test/unit/mail-auth.service.spec.ts b/backend/test/unit/mail-auth.service.spec.ts
new file mode 100644
index 0000000..17c0e9b
--- /dev/null
+++ b/backend/test/unit/mail-auth.service.spec.ts
@@ -0,0 +1,85 @@
+import { decrypt, encrypt } from '../../src/common/crypto';
+import { MailAuthService } from '../../src/mail/mail-auth.service';
+
+const KEY = 'c'.repeat(64);
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+function make(opts: { row?: unknown; configured?: boolean } = {}) {
+  const prisma: any = {
+    mailAccount: {
+      findUnique: jest.fn().mockResolvedValue(opts.row ?? null),
+      upsert: jest.fn().mockResolvedValue({}),
+      deleteMany: jest.fn().mockResolvedValue({ count: 1 }),
+    },
+  };
+  const env: Record<string, string> =
+    opts.configured === false ? { MS_TENANT_ID: 'common' } : { MS_CLIENT_ID: 'cid', MS_TENANT_ID: 'common', TOKEN_ENC_KEY: KEY };
+  const config: any = { get: (k: string) => env[k] };
+  return { prisma, svc: new MailAuthService(prisma, config) };
+}
+
+describe('MailAuthService', () => {
+  let fetchMock: jest.SpyInstance;
+  beforeEach(() => {
+    fetchMock = jest.spyOn(globalThis, 'fetch');
+  });
+  afterEach(() => jest.restoreAllMocks());
+
+  it('설정 없으면 configured=false, NOT_CONFIGURED', async () => {
+    const { svc } = make({ configured: false });
+    expect(svc.configured).toBe(false);
+    await expect(svc.getAccessToken()).rejects.toMatchObject({ code: 'NOT_CONFIGURED' });
+  });
+
+  it('계정 없으면 NOT_CONNECTED', async () => {
+    const { svc } = make();
+    await expect(svc.getAccessToken()).rejects.toMatchObject({ code: 'NOT_CONNECTED' });
+  });
+
+  it('리프레시: 새 토큰 암호화 저장, 액세스 토큰 캐시', async () => {
+    fetchMock.mockResolvedValue(json({ access_token: 'at', refresh_token: 'rt2', expires_in: 3600 }));
+    const { svc, prisma } = make({ row: { provider: 'outlook', refreshTokenEnc: encrypt('rt1', KEY) } });
+
+    expect(await svc.getAccessToken()).toBe('at');
+    expect(await svc.getAccessToken()).toBe('at');
+
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    const body = String((fetchMock.mock.calls[0] as [string, any])[1].body);
+    expect(body).toContain('grant_type=refresh_token');
+    expect(body).toContain('refresh_token=rt1');
+    const saved = prisma.mailAccount.upsert.mock.calls[0][0].update.refreshTokenEnc as string;
+    expect(saved).not.toContain('rt2');
+    expect(decrypt(saved, KEY)).toBe('rt2');
+  });
+
+  it('invalid_grant이면 계정 삭제 후 NOT_CONNECTED', async () => {
+    fetchMock.mockResolvedValue(json({ error: 'invalid_grant', error_description: 'expired' }, 400));
+    const { svc, prisma } = make({ row: { provider: 'outlook', refreshTokenEnc: encrypt('rt1', KEY) } });
+
+    await expect(svc.getAccessToken()).rejects.toMatchObject({ code: 'NOT_CONNECTED' });
+    expect(prisma.mailAccount.deleteMany).toHaveBeenCalled();
+  });
+
+  it('암호화 키가 바뀌면 AUTH_FAILED', async () => {
+    const { svc } = make({ row: { provider: 'outlook', refreshTokenEnc: encrypt('rt1', 'd'.repeat(64)) } });
+    await expect(svc.getAccessToken()).rejects.toMatchObject({ code: 'AUTH_FAILED' });
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('startDeviceLogin: 사용자 코드 반환, 읽기 전용 scope 요청', async () => {
+    fetchMock.mockResolvedValue(
+      json({ device_code: 'dc', user_code: 'ABCD-1234', verification_uri: 'https://microsoft.com/devicelogin', expires_in: 900, interval: 5 }),
+    );
+    const { svc } = make();
+
+    const res = await svc.startDeviceLogin();
+    await svc.disconnect(); // 백그라운드 폴링 중단
+
+    expect(res).toEqual({ userCode: 'ABCD-1234', verificationUri: 'https://microsoft.com/devicelogin', expiresIn: 900 });
+    const body = String((fetchMock.mock.calls[0] as [string, any])[1].body);
+    expect(body).toContain('Mail.Read');
+    expect(body).not.toContain('Mail.Send');
+    expect(body).not.toContain('ReadWrite');
+  });
+});
diff --git a/backend/test/unit/mail.service.spec.ts b/backend/test/unit/mail.service.spec.ts
new file mode 100644
index 0000000..11f554b
--- /dev/null
+++ b/backend/test/unit/mail.service.spec.ts
@@ -0,0 +1,94 @@
+import { MailService } from '../../src/mail/mail.service';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+function make() {
+  const auth: any = {
+    getAccessToken: jest.fn().mockResolvedValue('tok'),
+    invalidateAccessToken: jest.fn(),
+  };
+  const config: any = { get: (k: string) => ({ MAIL_BODY_MAX_CHARS: 10 })[k as 'MAIL_BODY_MAX_CHARS'] };
+  return { auth, svc: new MailService(auth, config) };
+}
+
+describe('MailService', () => {
+  let fetchMock: jest.SpyInstance;
+  beforeEach(() => {
+    fetchMock = jest.spyOn(globalThis, 'fetch');
+  });
+  afterEach(() => jest.restoreAllMocks());
+
+  it('list: 매핑, 안 읽음 필터, 토큰 헤더', async () => {
+    fetchMock.mockResolvedValue(
+      json({
+        value: [
+          {
+            id: 'a',
+            subject: 'S1',
+            from: { emailAddress: { name: 'Kim', address: 'k@x.com' } },
+            receivedDateTime: '2026-11-22T05:03:00Z',
+            isRead: false,
+            bodyPreview: 'hi',
+          },
+          { id: 'b', subject: null, receivedDateTime: '2026-11-21T05:03:00Z', isRead: true, bodyPreview: '' },
+        ],
+      }),
+    );
+    const { svc } = make();
+
+    const out = await svc.list({ top: 5, unreadOnly: true });
+
+    expect(out).toEqual([
+      { id: 'a', subject: 'S1', from: 'Kim <k@x.com>', receivedAt: '2026-11-22T05:03:00Z', isRead: false, preview: 'hi' },
+    ]);
+    const [url, init] = fetchMock.mock.calls[0] as [string, any];
+    expect(url).toContain('https://graph.microsoft.com/v1.0/me/mailFolders/inbox/messages?');
+    expect(init.headers.Authorization).toBe('Bearer tok');
+  });
+
+  it('get: text 본문 요청, 길이 제한', async () => {
+    fetchMock.mockResolvedValue(
+      json({
+        id: 'a',
+        subject: 'S',
+        receivedDateTime: '2026-11-22T05:03:00Z',
+        isRead: true,
+        body: { content: '0123456789ABCDEF' },
+      }),
+    );
+    const { svc } = make();
+
+    const d = await svc.get('a');
+
+    expect(d.body).toBe('0123456789');
+    expect(d.truncated).toBe(true);
+    expect((fetchMock.mock.calls[0] as [string, any])[1].headers.Prefer).toContain('text');
+  });
+
+  it('401이면 토큰 폐기 후 1회 재시도', async () => {
+    fetchMock
+      .mockResolvedValueOnce(new Response('', { status: 401 }))
+      .mockResolvedValueOnce(json({ value: [] }));
+    const { svc, auth } = make();
+
+    await svc.list({ top: 5, unreadOnly: false });
+
+    expect(auth.invalidateAccessToken).toHaveBeenCalledTimes(1);
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+  });
+
+  it('401 반복이면 NOT_CONNECTED', async () => {
+    fetchMock.mockImplementation(async () => new Response('', { status: 401 }));
+    const { svc } = make();
+    await expect(svc.list({ top: 1, unreadOnly: false })).rejects.toMatchObject({ code: 'NOT_CONNECTED' });
+  });
+
+  it('404 → NOT_FOUND, 5xx → UPSTREAM', async () => {
+    const { svc } = make();
+    fetchMock.mockResolvedValueOnce(new Response('', { status: 404 }));
+    await expect(svc.get('abcdefgh')).rejects.toMatchObject({ code: 'NOT_FOUND' });
+    fetchMock.mockResolvedValueOnce(new Response('', { status: 503 }));
+    await expect(svc.get('abcdefgh')).rejects.toMatchObject({ code: 'UPSTREAM' });
+  });
+});
