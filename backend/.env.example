# 서버 (기본: 로컬 루프백만 허용)
PORT=3000
HOST=127.0.0.1

# PostgreSQL (docker-compose.yml 기본값과 일치)
DATABASE_URL=postgresql://aura:aura@127.0.0.1:5432/aura?schema=public

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# 유휴 시 메모리 유지 시간. 0 = 응답 후 즉시 해제
OLLAMA_KEEP_ALIVE=5m
# 공부 집중 화면 분석용 비전 모델
STUDY_VISION_MODEL=gemma4:12b
# 모델 요청 타임아웃(ms)
MODEL_TIMEOUT_MS=120000

# 대화 (프롬프트에 포함할 최근 메시지 수)
HISTORY_LIMIT=20
# SYSTEM_PROMPT=

# 시각 표시 기준 시간대 (IANA)
TIMEZONE=Asia/Seoul

# Outlook 메일 읽기 (Microsoft Graph, 읽기 전용 Mail.Read). MS_CLIENT_ID와 TOKEN_ENC_KEY 둘 다 있어야 활성화.
# Entra 앱 등록: 플랫폼 "모바일 및 데스크톱", "공개 클라이언트 흐름 허용"=예, 위임 권한 Mail.Read / User.Read
# MS_CLIENT_ID=
# 개인+직장 계정: common / 직장 전용: 테넌트 ID
# MS_TENANT_ID=common
# 리프레시 토큰 암호화 키(64자리 hex). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKEN_ENC_KEY=
# MAIL_BODY_MAX_CHARS=4000
# MAIL_CONTEXT_COUNT=5
