# 서버 (기본: 로컬 루프백만 허용)
PORT=3000
HOST=127.0.0.1

# PostgreSQL (docker-compose.yml 기본값과 일치)
DATABASE_URL=postgresql://aura:aura@127.0.0.1:5432/aura?schema=public

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# 유휴 시 메모리 유지 시간. 0 = 응답 후 즉시 해제
OLLAMA_KEEP_ALIVE=5m
# 모델 요청 타임아웃(ms)
MODEL_TIMEOUT_MS=120000

# 대화 (프롬프트에 포함할 최근 메시지 수)
HISTORY_LIMIT=20
# SYSTEM_PROMPT=
