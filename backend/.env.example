# 서버 (기본: 로컬 루프백만 허용)
PORT=3000
# Android 앱(Tailscale)에서 접속하려면 0.0.0.0
HOST=127.0.0.1

# PostgreSQL (docker-compose.yml 기본값과 일치)
DATABASE_URL=postgresql://aura:aura@127.0.0.1:5432/aura?schema=public

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# 유휴 시 메모리 유지 시간. 0 = 응답 후 즉시 해제
OLLAMA_KEEP_ALIVE=5m
# 공부 집중 화면 분석용 비전 모델
STUDY_VISION_MODEL=gemma4:12b
# 모델 요청 타임아웃(ms)
MODEL_TIMEOUT_MS=120000

# 대화 (프롬프트에 포함할 최근 메시지 수)
HISTORY_LIMIT=20
# SYSTEM_PROMPT=

# 시각 표시 기준 시간대 (IANA)
TIMEZONE=Asia/Seoul

# Outlook 메일 읽기 + 일정 (Microsoft Graph: Mail.Read, Calendars.ReadWrite). MS_CLIENT_ID와 TOKEN_ENC_KEY 둘 다 있어야 활성화.
# Entra 앱 등록: 플랫폼 "모바일 및 데스크톱", "공개 클라이언트 흐름 허용"=예, 위임 권한 User.Read / Mail.Read / Calendars.ReadWrite
# MS_CLIENT_ID=
# 개인+직장 계정: common / 직장 전용: 테넌트 ID
# MS_TENANT_ID=common
# 리프레시 토큰 암호화 키(64자리 hex). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKEN_ENC_KEY=
# MAIL_BODY_MAX_CHARS=4000
# MAIL_CONTEXT_COUNT=5

# 웹 스크래핑(GIST 학사공지·공모전) 주기(분). 0 = 자동 실행 끔, 최소 15
# SCRAPE_INTERVAL_MIN=60

# PC 조작 (AI가 마우스·키보드). Python 3.10+ 와 pip install -r pc-agent/requirements.txt 필요
# 좌표 찍기 잘하는 비전 모델 권장: qwen2.5vl:7b. 비우면 STUDY_VISION_MODEL
# PC_VISION_MODEL=qwen2.5vl:7b
# PC_PYTHON=python
# PC_MAX_STEPS=25

# 도구 탭 OCR(이미지→글자). 비전 모델. 비우면 PC_VISION_MODEL → STUDY_VISION_MODEL
# OCR_VISION_MODEL=qwen2.5vl:7b
# 도구 탭 STT(음성→글자). faster-whisper 모델: tiny/base/small/medium/large-v3. 첫 사용 때 자동 다운로드
# pip install -r pc-agent/requirements-stt.txt 필요. Python 경로는 PC_PYTHON 공용
# STT_MODEL=small

# 관리자 로비 코드 (로비 왼쪽 위 'AURA is our Pride' 클릭). 비우면 내장 기본 코드
# ADMIN_CODE=
