generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  title     String?
  /// null = 일반 채팅, girlfriend = AI 여자친구 화면
  persona   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([persona])
}

model Message {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String
  model            String?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  /// 사용자가 생성을 중단한 응답
  stopped          Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// 외부 메일 계정 연동. 리프레시 토큰은 AES-256-GCM으로 암호화해 저장한다.
model MailAccount {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @unique
  email           String?
  refreshTokenEnc String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 앱 설정 (단일 행 id=1). null 이면 .env 기본값 사용.
model AppSettings {
  id                Int       @id @default(1)
  model             String?
  systemPrompt      String?
  /// AI PC 조작(마우스·키보드) 허용
  pcControl         Boolean   @default(true)
  /// 화면 읽기(스크린샷 분석) 허용. 끄면 공부 화면 감시·PC 조작 불가
  screenRead        Boolean   @default(true)
  /// 마이크 사용 허용 (STT 녹음)
  mic               Boolean   @default(true)
  /// 웹캠 사용 허용 (공부 집중 자세 분석)
  webcam            Boolean   @default(true)
  /// 도구 탭 OCR 비전 모델. null = .env
  ocrModel          String?
  /// 도구 탭 STT whisper 모델. null = .env
  sttModel          String?
  /// 기능별 실행 위치: local | api
  chatSource        String    @default("local")
  chatProvider      String?
  chatApiModel      String?
  ocrSource         String    @default("local")
  ocrProvider       String?
  ocrApiModel       String?
  sttSource         String    @default("local")
  sttProvider       String?
  sttApiModel       String?
  /// TTS 엔진: browser | edge | openai | gemini
  ttsEngine         String    @default("browser")
  ttsModel          String?
  ttsVoice          String?
  ttsRate           Float     @default(1)
  /// 채팅 답변 자동 읽기
  ttsAutoRead       Boolean   @default(false)
  /// AI 여자친구 성격 프롬프트. null = 기본값
  companionPrompt   String?
  /// AI 여자친구 전용 목소리 {engine,model,voice,rate,emotion}. null = 전역 TTS
  companionVoice    Json?
  /// 사용자 저장 프리셋 {persona:[{id,name,prompt}], voice:[{id,name,...}]}
  companionPresets  Json?
  /// 사용할 Live2D 모델 id (data/live2d/<id>)
  companionModel    String?
  /// AI 친구 호감도 0~100
  companionAffinity Int       @default(30)
  /// AI 친구 마지막 대화 시각
  companionLastAt   DateTime?
  /// 외부 API 월 비용 한도 (USD). null = 없음
  budgetUsd         Float?
  /// 한도 대비 경고 비율 (%)
  budgetWarnPct     Int       @default(80)
  /// 한도 넘으면 API 호출 차단
  budgetBlock       Boolean   @default(false)
  updatedAt         DateTime  @updatedAt
}

/// 외부 AI API 키 (gemini | anthropic | openai). AES-256-GCM 암호문만 저장
model ApiKey {
  provider  String   @id
  cipher    String
  /// 마스킹된 표시용 (앞4·뒤4)
  hint      String
  updatedAt DateTime @updatedAt
}

/// 사용자가 직접 저장·관리하는 장기 기억. 켜진 항목만 대화 프롬프트에 들어간다.
model Memory {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  category  String?
  enabled   Boolean  @default(true)
  /// manual: 기억 화면, chat: 채팅 "기억해" (사용자 확인 후)
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, updatedAt])
}

/// 공부 집중 세션 1회 (시작~종료). 클라이언트가 진행 중 주기적으로 upsert.
model StudySession {
  id        String   @id @db.Uuid
  startedAt DateTime
  endedAt   DateTime
  /// 휴식 제외 실제 집중 시간 (초)
  focusSec  Int      @default(0)
  /// 완료한 뽀모도로 집중 블록 수
  pomodoros Int      @default(0)
  posture   Int      @default(0)
  phone     Int      @default(0)
  slack     Int      @default(0)
  sleep     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([startedAt])
}

/// 폰 감시: 공부 중 딴짓 앱 사용 (Android 앱이 기록)
model PhoneEvent {
  id      String   @id @default(uuid()) @db.Uuid
  at      DateTime @default(now())
  /// 앱 패키지명 (com.google.android.youtube 등)
  package String
  label   String

  @@index([at])
}

/// 로비 웹사이트 바로가기 (크롬 새 탭처럼)
model WebShortcut {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  url       String
  /// 표시 위치: lobby | tools
  section   String   @default("lobby")
  /// 표시 순서 (작을수록 앞)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, position])
}

/// 웹 스크래핑으로 모은 글 (학사공지·공모전 등). source+externalId 로 중복 방지.
model ScrapedPost {
  id            String    @id @default(uuid()) @db.Uuid
  /// NewsSite.id
  source        String
  /// 사이트의 글 번호
  externalId    String
  title         String
  url           String
  /// 분류 (장학/납입금, 공모 분야 등)
  category      String?
  /// 작성자·주최사
  author        String?
  /// 게시일
  postedAt      DateTime?
  /// 마감일 (공모전)
  deadline      DateTime?
  /// 접수 시작일 (공모전, 상세 페이지에서 보충)
  startsAt      DateTime?
  /// 행사·활동 진행 기간
  eventStartsAt DateTime?
  eventEndsAt   DateTime?
  /// 간단한 내용 (대상·본문 앞부분 등)
  summary       String?
  /// 상세 페이지 확인 시각. null = 아직
  detailAt      DateTime?
  /// 읽음 처리 시각. null = 새 글
  seenAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([source, externalId])
  @@index([source, createdAt])
  @@index([seenAt])
  @@index([deadline])
}

/// 새 소식 카테고리 (예: 학사공지, 공모전). 카테고리 안에서 같은 글은 하나로 합쳐 보여줌.
model NewsCategory {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  sites     NewsSite[]
}

/// 스크래핑할 게시판 1개. 기본 사이트는 고정 id(gist-academic 등), 사용자가 추가한 건 uuid.
model NewsSite {
  id           String        @id
  name         String
  url          String
  /// 파서: auto | gist | kboard | egov | rss | wevity | linkareer
  parser       String        @default("auto")
  /// 선택: 글 링크 CSS 선택자 (auto 파서가 못 찾을 때)
  itemSelector String?
  categoryId   String?       @db.Uuid
  category     NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  enabled      Boolean       @default(true)
  position     Int           @default(0)
  lastRunAt    DateTime?
  lastOkAt     DateTime?
  lastError    String?
  /// 마지막 실행에서 새로 찾은 글 수
  lastNew      Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId, position])
}

/// 외부 AI API 호출 1회의 토큰 사용량 (비용 추정용)
model ApiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  at           DateTime @default(now())
  /// gemini | anthropic | openai
  provider     String
  model        String
  /// chat | ocr | stt
  feature      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// 길이 과금 음성 모델 (whisper-1)
  audioSec     Int      @default(0)

  @@index([at])
}

/// 모델별 단가 (USD / 100만 토큰). 사용자가 수정. 없으면 코드 기본값
model ApiPrice {
  model     String   @id
  input     Float
  output    Float
  updatedAt DateTime @updatedAt
}

/// 자격증 목록. 기본 목록은 고정 id(slug), 사용자가 추가한 건 custom=true
model Certificate {
  id           String     @id
  name         String
  /// 분야 (정보통신/IT 등)
  field        String
  /// 국가기술 | 국가전문 | 국가공인민간 | 민간 | 어학
  kind         String
  /// 등급 (기사, 1급 등)
  grade        String?
  /// 시행기관
  org          String
  url          String?
  summary      String?
  /// 일정 묶음 (qnet-기사 등). 같은 묶음은 같은 회차 일정 공유
  series       String?
  /// 평균 준비기간 (참고값)
  prep         String?
  /// 응시료 (참고값)
  fee          String?
  /// 사용자가 고친 준비기간·응시료 (기본값보다 우선)
  userPrep     String?
  userFee      String?
  /// 유효기간 (참고값)
  validity     String?
  userValidity String?
  /// 사용자가 매긴 유용도 0~10 (없으면 참고값 계산)
  userScore    Float?
  /// Q-net 종목코드 (취득자 통계 조회용, 종목 목록 확인 때 이름으로 채움)
  jmCd         String?
  /// 국가공인 받은 등급 (공인민간자격등록현황 기준, 일부 등급만 공인이면 그 등급만). '등급 없음' = 단일 등급 공인
  publicGrades String?
  /// 공인 유효기간 만료일
  publicUntil  String?
  /// 취득자 통계: 연도별 [{year, count}] + 누적, 받은 시각 (30일마다 갱신)
  statsYears   Json?
  statsTotal   Int?
  statsAt      DateTime?
  /// Q-net 종목 목록에서 새로 찾아 추가한 시각
  discoveredAt DateTime?
  starred      Boolean    @default(false)
  custom       Boolean    @default(false)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  exams        CertExam[]

  @@index([field])
}

/// 시험 회차 1개 (필기·실기 따로). Q-net 자동 수집 또는 직접 입력
model CertExam {
  id          String       @id @default(uuid()) @db.Uuid
  certId      String?
  cert        Certificate? @relation(fields: [certId], references: [id], onDelete: Cascade)
  /// certId 없을 때 묶음 전체 적용
  series      String?
  /// qnet | manual
  source      String       @default("manual")
  /// 자동 수집 중복 방지 키
  externalKey String?      @unique
  title       String
  /// 필기 | 실기 | null
  phase       String?
  regStart    DateTime?
  regEnd      DateTime?
  examStart   DateTime?
  examEnd     DateTime?
  resultAt    DateTime?
  note        String?
  createdAt   DateTime     @default(now())

  @@index([certId])
  @@index([series])
}

/// 자격증 일정 연동 설정 (공공데이터포털 Q-net API 키)
model CertConfig {
  id               Int       @id @default(1)
  qnetKey          String?
  lastSyncAt       DateTime?
  lastError        String?
  lastCount        Int       @default(0)
  /// 새 자격증 확인 (Q-net 종목 목록, 주 1회)
  lastCatalogAt    DateTime?
  lastCatalogNew   Int       @default(0)
  lastCatalogError String?
  /// 공공데이터 API 호출 수 (일·월 한도 관리). 날짜는 KST YYYY-MM-DD / YYYY-MM
  apiDay           String?
  apiDayCount      Int       @default(0)
  apiMonth         String?
  apiMonthCount    Int       @default(0)
}

/// 단어장 (사용자가 JSON 업로드). 간격 반복 복습 + 회독 + 퀴즈
model VocabDeck {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  /// 발음 읽기용 언어 코드 (예: ja-JP, en-US)
  language     String?
  /// 하루 새 카드 수
  newPerDay    Int           @default(20)
  /// 하루 복습 상한
  reviewPerDay Int           @default(200)
  /// 카드 방향: front(앞→뒤) | back(뒤→앞)
  direction    String        @default("front")
  /// 현재 회독 번호 (1부터)
  round        Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cards        VocabCard[]
  reviews      VocabReview[]
}

model VocabCard {
  id             String        @id @default(uuid()) @db.Uuid
  deckId         String        @db.Uuid
  deck           VocabDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  position       Int           @default(0)
  front          String
  back           String
  reading        String?
  example        String?
  exampleMeaning String?
  note           String?
  tags           String[]      @default([])
  /// SRS 상태: new | learning | review | relearning
  state          String        @default("new")
  due            DateTime      @default(now())
  /// 복습 간격 (일)
  interval       Int           @default(0)
  ease           Float         @default(2.5)
  /// 학습 단계 번호
  step           Int           @default(0)
  reps           Int           @default(0)
  lapses         Int           @default(0)
  firstAt        DateTime?
  lastAt         DateTime?
  /// 회독: 마지막으로 본 회독 번호, 외웠는지
  roundSeen      Int           @default(0)
  known          Boolean       @default(false)
  wrongCount     Int           @default(0)
  starred        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  reviews        VocabReview[]

  @@index([deckId, state, due])
  @@index([deckId, position])
}

/// 카드 1회 답변 기록 (통계용)
model VocabReview {
  id      String    @id @default(uuid()) @db.Uuid
  deckId  String    @db.Uuid
  deck    VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId  String    @db.Uuid
  card    VocabCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  at      DateTime  @default(now())
  /// srs | round | quiz
  mode    String
  /// srs: 1 다시 · 2 어려움 · 3 알맞음 · 4 쉬움. round·quiz: 0 틀림 · 1 맞음
  grade   Int
  correct Boolean

  @@index([deckId, at])
  @@index([at])
}
