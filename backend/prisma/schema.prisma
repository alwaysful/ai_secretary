generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String
  model            String?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  /// 사용자가 생성을 중단한 응답
  stopped          Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// 외부 메일 계정 연동. 리프레시 토큰은 AES-256-GCM으로 암호화해 저장한다.
model MailAccount {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @unique
  email           String?
  refreshTokenEnc String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 앱 설정 (단일 행 id=1). null 이면 .env 기본값 사용.
model AppSettings {
  id           Int      @id @default(1)
  model        String?
  systemPrompt String?
  updatedAt    DateTime @updatedAt
}
