generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String
  model            String?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  /// 사용자가 생성을 중단한 응답
  stopped          Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// 외부 메일 계정 연동. 리프레시 토큰은 AES-256-GCM으로 암호화해 저장한다.
model MailAccount {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @unique
  email           String?
  refreshTokenEnc String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 앱 설정 (단일 행 id=1). null 이면 .env 기본값 사용.
model AppSettings {
  id           Int      @id @default(1)
  model        String?
  systemPrompt String?
  updatedAt    DateTime @updatedAt
}

/// 사용자가 직접 저장·관리하는 장기 기억. 켜진 항목만 대화 프롬프트에 들어간다.
model Memory {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  category  String?
  enabled   Boolean  @default(true)
  /// manual: 기억 화면, chat: 채팅 "기억해" (사용자 확인 후)
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, updatedAt])
}

/// 공부 집중 세션 1회 (시작~종료). 클라이언트가 진행 중 주기적으로 upsert.
model StudySession {
  id        String   @id @db.Uuid
  startedAt DateTime
  endedAt   DateTime
  /// 휴식 제외 실제 집중 시간 (초)
  focusSec  Int      @default(0)
  /// 완료한 뽀모도로 집중 블록 수
  pomodoros Int      @default(0)
  posture   Int      @default(0)
  phone     Int      @default(0)
  slack     Int      @default(0)
  sleep     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([startedAt])
}

/// 폰 감시: 공부 중 딴짓 앱 사용 (Android 앱이 기록)
model PhoneEvent {
  id      String   @id @default(uuid()) @db.Uuid
  at      DateTime @default(now())
  /// 앱 패키지명 (com.google.android.youtube 등)
  package String
  label   String

  @@index([at])
}
