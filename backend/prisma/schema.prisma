generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String
  model            String?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  /// 사용자가 생성을 중단한 응답
  stopped          Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// 외부 메일 계정 연동. 리프레시 토큰은 AES-256-GCM으로 암호화해 저장한다.
model MailAccount {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @unique
  email           String?
  refreshTokenEnc String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 앱 설정 (단일 행 id=1). null 이면 .env 기본값 사용.
model AppSettings {
  id           Int      @id @default(1)
  model        String?
  systemPrompt String?
  /// AI PC 조작(마우스·키보드) 허용
  pcControl    Boolean  @default(true)
  /// 화면 읽기(스크린샷 분석) 허용. 끄면 공부 화면 감시·PC 조작 불가
  screenRead   Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

/// 사용자가 직접 저장·관리하는 장기 기억. 켜진 항목만 대화 프롬프트에 들어간다.
model Memory {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  category  String?
  enabled   Boolean  @default(true)
  /// manual: 기억 화면, chat: 채팅 "기억해" (사용자 확인 후)
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, updatedAt])
}

/// 공부 집중 세션 1회 (시작~종료). 클라이언트가 진행 중 주기적으로 upsert.
model StudySession {
  id        String   @id @db.Uuid
  startedAt DateTime
  endedAt   DateTime
  /// 휴식 제외 실제 집중 시간 (초)
  focusSec  Int      @default(0)
  /// 완료한 뽀모도로 집중 블록 수
  pomodoros Int      @default(0)
  posture   Int      @default(0)
  phone     Int      @default(0)
  slack     Int      @default(0)
  sleep     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([startedAt])
}

/// 폰 감시: 공부 중 딴짓 앱 사용 (Android 앱이 기록)
model PhoneEvent {
  id      String   @id @default(uuid()) @db.Uuid
  at      DateTime @default(now())
  /// 앱 패키지명 (com.google.android.youtube 등)
  package String
  label   String

  @@index([at])
}

/// 로비 웹사이트 바로가기 (크롬 새 탭처럼)
model WebShortcut {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  url       String
  /// 표시 위치: lobby | tools
  section   String   @default("lobby")
  /// 표시 순서 (작을수록 앞)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, position])
}

/// 웹 스크래핑으로 모은 글 (학사공지·공모전 등). source+externalId 로 중복 방지.
model ScrapedPost {
  id         String    @id @default(uuid()) @db.Uuid
  /// NewsSite.id
  source     String
  /// 사이트의 글 번호
  externalId String
  title      String
  url        String
  /// 분류 (장학/납입금, 공모 분야 등)
  category   String?
  /// 작성자·주최사
  author     String?
  /// 게시일
  postedAt   DateTime?
  /// 마감일 (공모전)
  deadline   DateTime?
  /// 접수 시작일 (공모전, 상세 페이지에서 보충)
  startsAt   DateTime?
  /// 상세 페이지 확인 시각. null = 아직
  detailAt   DateTime?
  /// 읽음 처리 시각. null = 새 글
  seenAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([source, externalId])
  @@index([source, createdAt])
  @@index([seenAt])
  @@index([deadline])
}

/// 새 소식 카테고리 (예: 학사공지, 공모전). 카테고리 안에서 같은 글은 하나로 합쳐 보여줌.
model NewsCategory {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  sites     NewsSite[]
}

/// 스크래핑할 게시판 1개. 기본 사이트는 고정 id(gist-academic 등), 사용자가 추가한 건 uuid.
model NewsSite {
  id           String        @id
  name         String
  url          String
  /// 파서: auto | gist | kboard | egov | rss | wevity | linkareer
  parser       String        @default("auto")
  /// 선택: 글 링크 CSS 선택자 (auto 파서가 못 찾을 때)
  itemSelector String?
  categoryId   String?       @db.Uuid
  category     NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  enabled      Boolean       @default(true)
  position     Int           @default(0)
  lastRunAt    DateTime?
  lastOkAt     DateTime?
  lastError    String?
  /// 마지막 실행에서 새로 찾은 글 수
  lastNew      Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId, position])
}
