index 0000000..e1e3dd3
--- /dev/null
+++ b/frontend/src/pages/MailPage.tsx
@@ -0,0 +1,113 @@
+import { useCallback, useEffect, useState } from 'react';
+import { api, type DeviceLogin, type MailAuthStatus, type MailSummary } from '../services/api';
+import { PageShell } from '../components/PageShell';
+
+export function MailPage(props: { onBack: () => void }) {
+  const [status, setStatus] = useState<MailAuthStatus | null>(null);
+  const [mails, setMails] = useState<MailSummary[] | null>(null);
+  const [unreadOnly, setUnreadOnly] = useState(false);
+  const [login, setLogin] = useState<DeviceLogin | null>(null);
+  const [error, setError] = useState('');
+
+  const loadStatus = useCallback(
+    () => api.mailStatus().then(setStatus, (e: Error) => setError(e.message)),
+    [],
+  );
+
+  useEffect(() => {
+    void loadStatus();
+  }, [loadStatus]);
+
+  // 로그인 대기 중이면 3초마다 상태 확인
+  useEffect(() => {
+    if (!login) return;
+    const t = setInterval(() => void loadStatus(), 3000);
+    return () => clearInterval(t);
+  }, [login, loadStatus]);
+
+  useEffect(() => {
+    if (status?.connected) setLogin(null);
+  }, [status?.connected]);
+
+  useEffect(() => {
+    if (!status?.connected) return;
+    let live = true;
+    setMails(null);
+    api.mailList(unreadOnly).then(
+      (m) => live && setMails(m),
+      (e: Error) => live && setError(e.message),
+    );
+    return () => {
+      live = false;
+    };
+  }, [status?.connected, unreadOnly]);
+
+  const start = async () => {
+    setError('');
+    try {
+      setLogin(await api.mailStart());
+    } catch (e) {
+      setError((e as Error).message);
+    }
+  };
+
+  const disconnect = async () => {
+    await api.mailDisconnect().catch((e: Error) => setError(e.message));
+    setMails(null);
+    await loadStatus();
+  };
+
+  return (
+    <PageShell title="메일" onBack={props.onBack}>
+      {error && <p className="err">{error}</p>}
+      {status && !status.configured && <p className="err">Outlook 미설정. backend/README.md 참고 (MS_CLIENT_ID, TOKEN_ENC_KEY).</p>}
+
+      {status?.configured && !status.connected && (
+        <div className="card">
+          <p>Outlook 미연결.</p>
+          {login ? (
+            <p>
+              <a href={login.verificationUri} target="_blank" rel="noreferrer">
+                {login.verificationUri}
+              </a>{' '}
+              에서 코드 입력: <code className="code">{login.userCode}</code>
+            </p>
+          ) : (
+            <button className="primary" onClick={() => void start()}>
+              Outlook 연결
+            </button>
+          )}
+        </div>
+      )}
+
+      {status?.connected && (
+        <>
+          <div className="chips">
+            <button className={unreadOnly ? 'chip' : 'chip on'} onClick={() => setUnreadOnly(false)}>
+              전체
+            </button>
+            <button className={unreadOnly ? 'chip on' : 'chip'} onClick={() => setUnreadOnly(true)}>
+              안 읽음
+            </button>
+            <span className="grow" />
+            <small className="muted">{status.email}</small>
+            <button className="ghost" onClick={() => void disconnect()}>
+              연결 해제
+            </button>
+          </div>
+          {mails === null && !error && <p className="muted">불러오는 중…</p>}
+          {mails?.length === 0 && <p className="muted">메일 없음.</p>}
+          {mails?.map((m) => (
+            <div key={m.id} className={m.isRead ? 'card mail' : 'card mail unread'}>
+              <strong>{m.subject}</strong>
+              <small>
+                {m.from} · {new Date(m.receivedAt).toLocaleString('ko-KR')}
+              </small>
+              {m.preview && <p>{m.preview}</p>}
+            </div>
+          ))}
+        </>
+      )}
+    </PageShell>
+  );
+}
