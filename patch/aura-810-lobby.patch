+import { useEffect, useState } from 'react';
+import type { PageId } from '../App';
+import { api, type Health } from '../services/api';
+
+interface Item {
+  id: PageId | null;
+  icon: string;
+  label: string;
+  hint?: string;
+}
+
+const MAIN: Item[] = [
+  { id: 'schedule', icon: '📅', label: '내 일정 보기' },
+  { id: 'chat', icon: '💬', label: 'AI 채팅하기' },
+  { id: 'mail', icon: '✉️', label: '메일 확인', hint: '읽기 전용' },
+];
+
+const SYSTEM: Item[] = [
+  { id: 'status', icon: '🩺', label: '시스템 상태', hint: 'DB · 모델' },
+  { id: null, icon: '🎙️', label: '음성', hint: '준비 중' },
+  { id: null, icon: '🛠️', label: '도구', hint: '준비 중' },
+];
+
+function Links(props: { items: Item[]; onNavigate: (p: PageId) => void }) {
+  return (
+    <div className="box">
+      {props.items.map((it) => (
+        <button key={it.label} className="link" disabled={it.id === null} onClick={() => it.id && props.onNavigate(it.id)}>
+          <span className="ic">{it.icon}</span>
+          <span className="txt">{it.label}</span>
+          {it.hint && <small>{it.hint}</small>}
+        </button>
+      ))}
+    </div>
+  );
+}
+
+export function Lobby(props: { onNavigate: (p: PageId) => void }) {
+  const [health, setHealth] = useState<Health | null | 'down'>(null);
+
+  useEffect(() => {
+    api.health().then(setHealth, () => setHealth('down'));
+  }, []);
+
+  const dot = health === null ? 'wait' : health === 'down' || health.status !== 'ok' ? 'bad' : 'ok';
+  const statusText =
+    health === null ? '확인 중' : health === 'down' ? '백엔드 연결 안 됨' : `서버 ${health.status} · ${health.model.name}`;
+  const today = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'full' }).format(new Date());
+
+  return (
+    <div className="page">
+      <div className="logo">A</div>
+      <div className="meta">
+        <span>
+          <i className={`dot ${dot}`} />
+          {statusText}
+        </span>
+        <span>{today}</span>
+      </div>
+      <h1 className="title">AURA 810</h1>
+      <div className="cols">
+        <section>
+          <h3>바로가기</h3>
+          <Links items={MAIN} onNavigate={props.onNavigate} />
+        </section>
+        <section>
+          <h3>시스템</h3>
+          <Links items={SYSTEM} onNavigate={props.onNavigate} />
+        </section>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/pages/MailPage.tsx b/frontend/src/pages/MailPage.tsx
