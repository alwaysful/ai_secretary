+import { lazy, Suspense, useState } from 'react';
+import { ErrorBoundary } from './components/ErrorBoundary';
+import { Lobby } from './pages/Lobby';
+
+export type PageId = 'lobby' | 'schedule' | 'chat' | 'mail' | 'status';
+
+// 로비는 즉시 로드. 나머지 화면은 진입 시 로드 → 한 화면이 깨져도 로비는 항상 뜬다.
+const Chat = lazy(() => import('./pages/Chat').then((m) => ({ default: m.Chat })));
+const MailPage = lazy(() => import('./pages/MailPage').then((m) => ({ default: m.MailPage })));
+const Schedule = lazy(() => import('./pages/Schedule').then((m) => ({ default: m.Schedule })));
+const Status = lazy(() => import('./pages/Status').then((m) => ({ default: m.Status })));
+
+export function App() {
+  const [page, setPage] = useState<PageId>('lobby');
+  const back = () => setPage('lobby');
+
+  if (page === 'lobby') {
+    return (
+      <ErrorBoundary>
+        <Lobby onNavigate={setPage} />
+      </ErrorBoundary>
+    );
+  }
+
+  return (
+    <ErrorBoundary key={page} onBack={back}>
+      <Suspense fallback={<p className="muted" style={{ padding: 24 }}>불러오는 중…</p>}>
+        {page === 'schedule' && <Schedule onBack={back} />}
+        {page === 'chat' && <Chat onBack={back} />}
+        {page === 'mail' && <MailPage onBack={back} />}
+        {page === 'status' && <Status onBack={back} />}
+      </Suspense>
+    </ErrorBoundary>
+  );
+}
