+import { useCallback, useEffect, useRef, useState } from 'react';
+import { api, streamMessage, type Conversation, type Message } from '../services/api';
+import { PageShell } from '../components/PageShell';
+
+interface Line {
+  key: string;
+  role: 'USER' | 'ASSISTANT';
+  content: string;
+}
+
+const toLines = (ms: Message[]): Line[] =>
+  ms.filter((m) => m.role !== 'SYSTEM').map((m) => ({ key: m.id, role: m.role as Line['role'], content: m.content }));
+
+export function Chat(props: { onBack: () => void }) {
+  const [convs, setConvs] = useState<Conversation[]>([]);
+  const [current, setCurrent] = useState<string | null>(null);
+  const [lines, setLines] = useState<Line[]>([]);
+  const [input, setInput] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const abortRef = useRef<AbortController | null>(null);
+  const endRef = useRef<HTMLDivElement>(null);
+
+  const refresh = useCallback(() => api.conversations().then(setConvs, (e: Error) => setError(e.message)), []);
+
+  useEffect(() => {
+    void refresh();
+    return () => abortRef.current?.abort();
+  }, [refresh]);
+
+  useEffect(() => {
+    endRef.current?.scrollIntoView({ behavior: 'smooth' });
+  }, [lines]);
+
+  const open = async (id: string) => {
+    setCurrent(id);
+    setError('');
+    try {
+      setLines(toLines(await api.messages(id)));
+    } catch (e) {
+      setError((e as Error).message);
+    }
+  };
+
+  const newChat = () => {
+    setCurrent(null);
+    setLines([]);
+    setError('');
+  };
+
+  const send = async () => {
+    const text = input.trim();
+    if (!text || busy) return;
+    setInput('');
+    setBusy(true);
+    setError('');
+    const ac = new AbortController();
+    abortRef.current = ac;
+    try {
+      let id = current;
+      if (!id) {
+        const c = await api.createConversation(text.slice(0, 40));
+        id = c.id;
+        setCurrent(id);
+      }
+      setLines((l) => [...l, { key: `u${Date.now()}`, role: 'USER', content: text }, { key: `a${Date.now()}`, role: 'ASSISTANT', content: '' }]);
+      await streamMessage(
+        id,
+        text,
+        (t) =>
+          setLines((l) => {
+            const copy = l.slice();
+            const last = copy[copy.length - 1];
+            copy[copy.length - 1] = { ...last, content: last.content + t };
+            return copy;
+          }),
+        ac.signal,
+      );
+      void refresh();
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setBusy(false);
+      abortRef.current = null;
+    }
+  };
+
+  return (
+    <PageShell title="AI 채팅" onBack={props.onBack}>
+      <div className="chat">
+        <aside className="side">
+          <button className="primary" onClick={newChat}>
+            + 새 대화
+          </button>
+          {convs.map((c) => (
+            <button key={c.id} className={c.id === current ? 'conv on' : 'conv'} onClick={() => void open(c.id)}>
+              {c.title || '제목 없음'}
+            </button>
+          ))}
+        </aside>
+        <section className="pane">
+          <div className="msgs">
+            {lines.length === 0 && <p className="muted">메시지를 입력해 시작.</p>}
+            {lines.map((m) => (
+              <div key={m.key} className={m.role === 'USER' ? 'bub me' : 'bub ai'}>
+                {m.content || (busy ? '…' : '')}
+              </div>
+            ))}
+            <div ref={endRef} />
+          </div>
+          {error && <p className="err">{error}</p>}
+          <form
+            className="compose"
+            onSubmit={(e) => {
+              e.preventDefault();
+              void send();
+            }}
+          >
+            <input value={input} onChange={(e) => setInput(e.target.value)} placeholder="메시지 입력" maxLength={8000} />
+            {busy ? (
+              <button type="button" onClick={() => abortRef.current?.abort()}>
+                중지
+              </button>
+            ) : (
+              <button className="primary" type="submit" disabled={!input.trim()}>
+                전송
+              </button>
+            )}
+          </form>
+        </section>
+      </div>
+    </PageShell>
+  );
+}
