+// /api/* → 백엔드(127.0.0.1:3000). 같은 출처로 보이므로 CORS 불필요.
+export default defineConfig({
+  plugins: [react()],
+  server: {
+    host: '127.0.0.1',
+    port: 5173,
+    strictPort: true, // 5173이 점유 중이면 다른 포트로 슬쩍 옮기지 않고 오류로 알림
+    open: true,
+    proxy: {
+      '/api': {
+        target: 'http://127.0.0.1:3000',
+        changeOrigin: true,
+        rewrite: (p) => p.replace(/^\/api/, ''),
