diff --git a/frontend/src/services/api.ts b/frontend/src/services/api.ts
new file mode 100644
index 0000000..8e1d1a6
--- /dev/null
+++ b/frontend/src/services/api.ts
@@ -0,0 +1,136 @@
+const BASE = '/api';
+
+export class ApiError extends Error {
+  constructor(
+    public readonly status: number,
+    message: string,
+  ) {
+    super(message);
+    this.name = 'ApiError';
+  }
+}
+
+async function request<T>(path: string, init?: RequestInit): Promise<T> {
+  let res: Response;
+  try {
+    res = await fetch(BASE + path, init);
+  } catch {
+    throw new ApiError(0, '백엔드에 연결할 수 없음');
+  }
+  if (!res.ok) {
+    const body = (await res.json().catch(() => ({}))) as { message?: string | string[] };
+    const msg = Array.isArray(body.message) ? body.message.join(', ') : body.message;
+    throw new ApiError(res.status, msg ?? `HTTP ${res.status}`);
+  }
+  if (res.status === 204) return undefined as T;
+  return (await res.json()) as T;
+}
+
+const json = (body: unknown): RequestInit => ({
+  method: 'POST',
+  headers: { 'Content-Type': 'application/json' },
+  body: JSON.stringify(body),
+});
+
+export interface Conversation {
+  id: string;
+  title: string | null;
+  updatedAt: string;
+}
+export interface Message {
+  id: string;
+  role: 'SYSTEM' | 'USER' | 'ASSISTANT';
+  content: string;
+}
+export interface Health {
+  status: string;
+  db: string;
+  model: { name: string; state: string };
+}
+export interface CalendarEvent {
+  id: string;
+  subject: string;
+  start: string;
+  end: string;
+  isAllDay: boolean;
+  location: string;
+}
+export interface MailSummary {
+  id: string;
+  subject: string;
+  from: string;
+  receivedAt: string;
+  isRead: boolean;
+  preview: string;
+}
+export interface MailAuthStatus {
+  configured: boolean;
+  connected: boolean;
+  pending: boolean;
+  email: string | null;
+}
+export interface DeviceLogin {
+  userCode: string;
+  verificationUri: string;
+  expiresIn: number;
+}
+
+export const api = {
+  health: () => request<Health>('/health'),
+  conversations: () => request<Conversation[]>('/conversations'),
+  createConversation: (title?: string) => request<Conversation>('/conversations', json({ title })),
+  messages: (id: string) => request<Message[]>(`/conversations/${id}/messages`),
+  events: (days: number) => request<CalendarEvent[]>(`/calendar/events?days=${days}`),
+  mailStatus: () => request<MailAuthStatus>('/mail/auth/status'),
+  mailStart: () => request<DeviceLogin>('/mail/auth/start', { method: 'POST' }),
+  mailDisconnect: () => request<void>('/mail/auth', { method: 'DELETE' }),
+  mailList: (unreadOnly: boolean) => request<MailSummary[]>(`/mail/messages?top=15&unreadOnly=${unreadOnly}`),
+};
+
+/** SSE 스트림. 토큰마다 onToken 호출. 서버 오류 이벤트는 throw. */
+export async function streamMessage(
+  id: string,
+  content: string,
+  onToken: (t: string) => void,
+  signal?: AbortSignal,
+): Promise<void> {
+  let res: Response;
+  try {
+    res = await fetch(`${BASE}/conversations/${id}/messages/stream`, { ...json({ content }), signal });
+  } catch (e) {
+    if (signal?.aborted) return;
+    throw new ApiError(0, '백엔드에 연결할 수 없음');
+  }
+  if (!res.ok || !res.body) throw new ApiError(res.status, `HTTP ${res.status}`);
+
+  const reader = res.body.getReader();
+  const decoder = new TextDecoder();
+  let buf = '';
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      buf += decoder.decode(value, { stream: true });
+      let sep: number;
+      while ((sep = buf.indexOf('\n\n')) >= 0) {
+        const frame = buf.slice(0, sep);
+        buf = buf.slice(sep + 2);
+        let event = 'message';
+        let data = '';
+        for (const line of frame.split('\n')) {
+          if (line.startsWith('event:')) event = line.slice(6).trim();
+          else if (line.startsWith('data:')) data += line.slice(5).trim();
+        }
+        if (event === 'done') return;
+        const parsed = data ? (JSON.parse(data) as { token?: string; message?: string }) : {};
+        if (event === 'error') throw new ApiError(500, parsed.message ?? 'stream error');
+        if (parsed.token) onToken(parsed.token);
+      }
+    }
+  } catch (e) {
+    if (signal?.aborted) return;
+    throw e;
+  } finally {
+    reader.cancel().catch(() => undefined);
+  }
+}
diff --git a/frontend/src/styles.css b/frontend/src/styles.css
new file mode 100644
index 0000000..09f2d17
--- /dev/null
+++ b/frontend/src/styles.css
@@ -0,0 +1,92 @@
+:root {
+  --bg: #ffffff;
+  --soft: #f7f6f3;
+  --line: #e9e9e7;
+  --text: #2f3437;
+  --muted: #9b9a97;
+  --accent: #0f6b63;
+  --bad: #d44c47;
+  --ok: #2f9e6e;
+  color-scheme: light;
+}
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font-family: system-ui, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
+}
+button { font: inherit; color: inherit; cursor: pointer; border: 1px solid var(--line); background: var(--bg); border-radius: 8px; padding: 8px 14px; }
+button:hover:not(:disabled) { background: var(--soft); }
+button:disabled { cursor: not-allowed; }
+button.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
+button.primary:hover:not(:disabled) { background: #0c5953; }
+button.primary:disabled { opacity: 0.5; }
+button.ghost { background: transparent; border-color: transparent; color: var(--muted); }
+input { font: inherit; color: inherit; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
+a { color: var(--accent); }
+.muted { color: var(--muted); }
+.err { color: var(--bad); }
+.grow { flex: 1; }
+.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); display: inline-block; margin-right: 6px; }
+.dot.ok { background: var(--ok); }
+.dot.bad { background: var(--bad); }
+
+/* 로비 (Notion 스타일 페이지) */
+.page { max-width: 1120px; margin: 0 auto; padding: 32px 34px 80px; }
+.logo { width: 96px; height: 96px; background: #000; color: #e53935; border-radius: 6px; display: grid; place-items: center; font-size: 40px; font-weight: 800; }
+.meta { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; color: var(--muted); font-size: 14px; margin: 18px 0 10px; }
+.title { font-size: 44px; font-weight: 800; margin: 0 0 30px; letter-spacing: 0.01em; }
+.cols { display: grid; grid-template-columns: 300px 1fr; gap: 56px; align-items: start; }
+.cols h3 { font-size: 24px; font-weight: 700; margin: 0 0 14px; }
+.box { border: 1px solid var(--line); border-radius: 14px; padding: 22px 26px; display: flex; flex-direction: column; gap: 14px; }
+.link { display: flex; align-items: center; gap: 10px; border: 0; background: none; padding: 0; border-radius: 0; text-align: left; font-weight: 700; font-size: 17px; }
+.link:hover:not(:disabled) { background: none; }
+.link .txt { border-bottom: 1.5px solid #d3d3d0; }
+.link:hover:not(:disabled) .txt { border-bottom-color: var(--text); }
+.link small { color: var(--muted); font-weight: 400; font-size: 13px; }
+.link:disabled { color: var(--muted); }
+.link:disabled .txt { border-bottom-color: transparent; }
+.ic { position: relative; width: 26px; font-size: 19px; line-height: 1; }
+.ic::after { content: '↗'; position: absolute; right: -3px; bottom: -6px; font-size: 11px; font-weight: 900; line-height: 1; color: #37352f; background: var(--bg); border-radius: 3px; }
+.link:disabled .ic::after { display: none; }
+.lobby { padding: 32px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
+
+/* 하위 화면 공통 */
+.shell { min-height: 100vh; display: flex; flex-direction: column; }
+.bar { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-bottom: 1px solid var(--line); }
+.bar h2 { margin: 0; font-size: 18px; }
+.body { flex: 1; width: min(960px, 100%); margin: 0 auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; min-height: 0; }
+
+.chips { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.chip { border-radius: 999px; padding: 6px 14px; }
+.chip.on { background: var(--accent); border-color: var(--accent); color: #fff; }
+.card { background: var(--bg); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; }
+.card h3 { margin: 0; font-size: 15px; color: var(--accent); }
+.row { display: flex; gap: 14px; align-items: flex-start; }
+.row time { min-width: 96px; color: var(--muted); font-variant-numeric: tabular-nums; }
+.row small { display: block; color: var(--muted); }
+.mail.unread { border-color: var(--accent); }
+.mail small { color: var(--muted); }
+.mail p { margin: 0; color: var(--muted); }
+.code { font-size: 20px; letter-spacing: 0.15em; background: var(--soft); padding: 2px 8px; border-radius: 6px; }
+
+.chat { flex: 1; display: grid; grid-template-columns: 220px 1fr; gap: 12px; min-height: 0; height: calc(100vh - 110px); }
+.side { display: flex; flex-direction: column; gap: 6px; overflow-y: auto; }
+.conv { text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.conv.on { border-color: var(--accent); background: var(--soft); }
+.pane { display: flex; flex-direction: column; min-height: 0; }
+.msgs { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-right: 4px; }
+.bub { max-width: 80%; padding: 10px 14px; border-radius: 14px; white-space: pre-wrap; line-height: 1.5; }
+.bub.me { align-self: flex-end; background: var(--accent); color: #fff; }
+.bub.ai { align-self: flex-start; background: var(--soft); border: 1px solid var(--line); }
+.compose { display: flex; gap: 8px; padding-top: 10px; }
+.compose input { flex: 1; }
+
+@media (max-width: 760px) {
+  .cols { grid-template-columns: 1fr; gap: 28px; }
+  .title { font-size: 34px; }
+  .chat { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
+  .side { flex-direction: row; overflow-x: auto; }
+  .conv { max-width: 140px; }
+}
