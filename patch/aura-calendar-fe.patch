index 0000000..4fa8195
--- /dev/null
+++ b/frontend/src/services/mock-data.ts
@@ -0,0 +1,41 @@
+import type { CalendarEvent } from '../types';
+import { addDays, startOfDay } from '../lib/date';
+
+/** 오늘 기준 -60일 ~ +90일의 가짜 일정. 백엔드 연동 전 UI 확인용. */
+export function buildMockEvents(now: Date = new Date()): CalendarEvent[] {
+  const today = startOfDay(now);
+  const out: CalendarEvent[] = [];
+  let n = 0;
+  const add = (day: Date, sh: number, sm: number, mins: number, p: Partial<CalendarEvent> & { subject: string }) => {
+    const start = new Date(day.getFullYear(), day.getMonth(), day.getDate(), sh, sm);
+    const end = new Date(start.getTime() + mins * 60_000);
+    out.push({ id: `mock-${n++}`, isAllDay: false, categories: [], start: start.toISOString(), end: end.toISOString(), ...p });
+  };
+  const allDay = (day: Date, days: number, p: Partial<CalendarEvent> & { subject: string }) =>
+    out.push({
+      id: `mock-${n++}`,
+      isAllDay: true,
+      categories: ['행사'],
+      start: day.toISOString(),
+      end: addDays(day, days).toISOString(),
+      ...p,
+    });
+
+  for (let i = -60; i <= 90; i++) {
+    const d = addDays(today, i);
+    const dow = d.getDay();
+    if (dow === 1) add(d, 10, 0, 60, { subject: '팀 주간회의', location: '회의실 A', organizer: '김팀장' });
+    if (dow === 3) add(d, 15, 0, 30, { subject: '1:1 미팅', organizer: '박매니저' });
+    if (dow === 5) add(d, 17, 0, 60, { subject: '주간 회고', location: 'Teams' });
+    if (i % 9 === 0 && dow !== 0 && dow !== 6) add(d, 12, 0, 60, { subject: '점심 약속', location: '사내 식당' });
+  }
+  allDay(addDays(today, 5), 2, { subject: '전사 워크숍', location: '제주', organizer: '인사팀' });
+  allDay(addDays(today, 12), 1, { subject: '창립기념일' });
+  allDay(addDays(today, -10), 1, { subject: '연차', categories: [] });
+  add(addDays(today, 3), 14, 0, 120, { subject: 'AI 세미나', categories: ['세미나'], location: '대강당', organizer: '교육팀' });
+  add(addDays(today, 3), 10, 0, 60, { subject: '고객사 미팅', location: '고객사', organizer: '영업팀' });
+  add(addDays(today, 3), 16, 30, 30, { subject: '코드 리뷰' });
+  add(addDays(today, 3), 18, 0, 90, { subject: '팀 회식', categories: ['행사'], location: '강남역' });
+  add(addDays(today, 20), 9, 0, 480, { subject: '개발자 컨퍼런스', categories: ['컨퍼런스'], location: '코엑스' });
+  return out;
+}
