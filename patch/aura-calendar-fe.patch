+import type { CalendarEvent } from '../types';
+import { dayKey, formatDayLong, formatTime, isSameDay, WEEKDAYS } from '../lib/date';
+import { classify, eventsOnDay } from '../lib/events';
+
+const MAX_CHIPS = 3;
+
+interface Props {
+  grid: Date[];
+  month: Date;
+  events: CalendarEvent[];
+  selected: Date;
+  today: Date;
+  onSelect(d: Date): void;
+}
+
+export function MonthGrid({ grid, month, events, selected, today, onSelect }: Props) {
+  return (
+    <div className="month">
+      <div className="month__head">
+        {WEEKDAYS.map((w, i) => (
+          <div key={w} className={i === 0 ? 'sun' : i === 6 ? 'sat' : ''}>{w}</div>
+        ))}
+      </div>
+      <div className="month__body">
+        {grid.map((day) => {
+          const list = eventsOnDay(events, day);
+          const cls = [
+            'cell',
+            day.getMonth() !== month.getMonth() && 'cell--other',
+            isSameDay(day, selected) && 'cell--sel',
+            isSameDay(day, today) && 'cell--today',
+          ]
+            .filter(Boolean)
+            .join(' ');
+          return (
+            <button
+              key={dayKey(day)}
+              type="button"
+              className={cls}
+              onClick={() => onSelect(day)}
+              aria-label={`${formatDayLong(day)}, ${list.length}건`}
+            >
+              <span className="cell__num">{day.getDate()}</span>
+              {list.slice(0, MAX_CHIPS).map((ev) => (
+                <span key={ev.id} className={`chip chip--${classify(ev)}`}>
+                  {ev.isAllDay ? '' : `${formatTime(new Date(ev.start))} `}
+                  {ev.subject}
+                </span>
+              ))}
+              {list.length > MAX_CHIPS && <span className="more">+{list.length - MAX_CHIPS}건</span>}
+            </button>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
