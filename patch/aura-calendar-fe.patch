+/** 백엔드(Outlook/Graph)가 정규화해서 내려줄 일정 형식. start/end는 ISO 8601. 종일 일정의 end는 배타적(다음날 00:00). */
+export interface CalendarEvent {
+  id: string;
+  subject: string;
+  start: string;
+  end: string;
+  isAllDay: boolean;
+  location?: string;
+  organizer?: string;
+  categories: string[];
+  webLink?: string;
+}
+
+export type EventKind = 'event' | 'schedule';
+export type View = 'month' | 'agenda';
+export type Filter = 'all' | EventKind;
+
+export interface CalendarApi {
+  list(from: Date, to: Date, signal?: AbortSignal): Promise<CalendarEvent[]>;
+}
