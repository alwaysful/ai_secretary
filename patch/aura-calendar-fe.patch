+import type { CalendarEvent } from '../types';
+import { classify, formatRange, safeHttpUrl } from '../lib/events';
+
+export function EventRow({ ev }: { ev: CalendarEvent }) {
+  const kind = classify(ev);
+  const link = safeHttpUrl(ev.webLink);
+  return (
+    <li className={`row row--${kind}`}>
+      <span className="row__time">{formatRange(ev)}</span>
+      <div className="row__body">
+        <div>
+          <strong>{ev.subject}</strong> <span className={`badge badge--${kind}`}>{kind === 'event' ? '행사' : '일정'}</span>
+        </div>
+        {ev.location && <div className="row__meta">장소: {ev.location}</div>}
+        {ev.organizer && <div className="row__meta">주최: {ev.organizer}</div>}
+        {link && (
+          <a href={link} target="_blank" rel="noopener noreferrer">
+            Outlook에서 열기
+          </a>
+        )}
+      </div>
+    </li>
+  );
+}
