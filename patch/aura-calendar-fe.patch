+import type { Filter, View } from '../types';
+import { formatMonth } from '../lib/date';
+
+interface Props {
+  month: Date;
+  view: View;
+  filter: Filter;
+  onPrev(): void;
+  onNext(): void;
+  onToday(): void;
+  onView(v: View): void;
+  onFilter(f: Filter): void;
+}
+
+const FILTERS: [Filter, string][] = [
+  ['all', '전체'],
+  ['schedule', '일정'],
+  ['event', '행사'],
+];
+
+export function Toolbar(p: Props) {
+  return (
+    <header className="toolbar">
+      <div className="toolbar__nav">
+        <button type="button" onClick={p.onPrev} aria-label="이전 달">‹</button>
+        <h1>{formatMonth(p.month)}</h1>
+        <button type="button" onClick={p.onNext} aria-label="다음 달">›</button>
+        <button type="button" onClick={p.onToday}>오늘</button>
+      </div>
+      <div className="seg" role="group" aria-label="종류">
+        {FILTERS.map(([k, label]) => (
+          <button key={k} type="button" aria-pressed={p.filter === k} onClick={() => p.onFilter(k)}>
+            {label}
+          </button>
+        ))}
+      </div>
+      <div className="seg" role="group" aria-label="보기">
+        <button type="button" aria-pressed={p.view === 'month'} onClick={() => p.onView('month')}>월</button>
+        <button type="button" aria-pressed={p.view === 'agenda'} onClick={() => p.onView('agenda')}>목록</button>
+      </div>
+    </header>
+  );
+}
