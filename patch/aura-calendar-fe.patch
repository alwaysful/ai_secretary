+:root {
+  --bg: #fff; --fg: #1f2328; --muted: #6b7280; --line: #e5e7eb; --surface: #f6f7f9;
+  --event: #7c3aed; --event-bg: #ede9fe; --sched: #2563eb; --sched-bg: #dbeafe; --today: #ef4444;
+  color-scheme: light dark;
+  font-family: system-ui, -apple-system, 'Segoe UI', 'Malgun Gothic', sans-serif;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #14161a; --fg: #e6e8eb; --muted: #9aa1ab; --line: #2a2e35; --surface: #1c1f25;
+    --event: #c4b5fd; --event-bg: #3b2a6b; --sched: #93c5fd; --sched-bg: #1e3a5f; --today: #f87171;
+  }
+}
+* { box-sizing: border-box; }
+body { margin: 0; background: var(--bg); color: var(--fg); }
+button { font: inherit; color: inherit; cursor: pointer; }
+.app { max-width: 1200px; margin: 0 auto; padding: 1rem; }
+.toolbar { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
+.toolbar__nav { display: flex; align-items: center; gap: .5rem; }
+.toolbar h1 { font-size: 1.25rem; margin: 0 .5rem; min-width: 7.5rem; text-align: center; }
+.toolbar button, .seg button, .error button { border: 1px solid var(--line); background: var(--surface); border-radius: 6px; padding: .35rem .7rem; }
+.seg { display: flex; }
+.seg button { border-radius: 0; }
+.seg button:first-child { border-radius: 6px 0 0 6px; }
+.seg button:last-child { border-radius: 0 6px 6px 0; }
+.seg button[aria-pressed='true'] { background: var(--sched); color: #fff; border-color: var(--sched); }
+.layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 1rem; align-items: start; }
+.layout--single { grid-template-columns: minmax(0, 1fr); }
+@media (max-width: 860px) { .layout { grid-template-columns: minmax(0, 1fr); } }
+.month { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
+.month__head, .month__body { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
+.month__head div { padding: .4rem; text-align: center; font-size: .8rem; color: var(--muted); background: var(--surface); }
+.sun { color: var(--today) !important; } .sat { color: var(--sched) !important; }
+.cell { display: flex; flex-direction: column; gap: 2px; min-height: 104px; padding: 4px; border: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); background: var(--bg); text-align: left; overflow: hidden; }
+.cell:nth-child(7n + 1) { border-left: 0; }
+.cell--other { opacity: .45; }
+.cell--sel { outline: 2px solid var(--sched); outline-offset: -2px; }
+.cell__num { font-size: .8rem; width: 1.6rem; height: 1.6rem; line-height: 1.6rem; text-align: center; border-radius: 50%; }
+.cell--today .cell__num { background: var(--today); color: #fff; }
+.chip { display: block; font-size: .72rem; padding: 1px 4px; border-radius: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.chip--event { background: var(--event-bg); color: var(--event); }
+.chip--schedule { background: var(--sched-bg); color: var(--sched); }
+.more { font-size: .72rem; color: var(--muted); }
+.panel, .agenda section { border: 1px solid var(--line); border-radius: 8px; padding: .75rem; background: var(--surface); }
+.panel h2, .agenda h3 { font-size: 1rem; margin: 0 0 .5rem; }
+.agenda { display: grid; gap: .75rem; }
+ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
+.row { display: grid; grid-template-columns: 5.5rem 1fr; gap: .5rem; padding-left: .5rem; border-left: 3px solid var(--sched); font-size: .9rem; }
+.row--event { border-left-color: var(--event); }
+.row__time { color: var(--muted); font-variant-numeric: tabular-nums; }
+.row__meta { color: var(--muted); font-size: .8rem; }
+.badge { font-size: .7rem; padding: 0 .35rem; border-radius: 999px; }
+.badge--event { background: var(--event-bg); color: var(--event); }
+.badge--schedule { background: var(--sched-bg); color: var(--sched); }
+.empty, .loading { color: var(--muted); }
+.error { color: var(--today); }
+a { color: var(--sched); }
