+import { describe, expect, it } from 'vitest';
+import { addMonths, dayKey, isSameDay, monthGrid } from './date';
+
+describe('date', () => {
+  it('monthGrid: 42칸, 일요일 시작', () => {
+    const g = monthGrid(new Date(2026, 10, 15)); // 2026-11-01은 일요일
+    expect(g).toHaveLength(42);
+    expect(dayKey(g[0])).toBe('2026-11-01');
+    const dec = monthGrid(new Date(2026, 11, 1)); // 12-01은 화요일
+    expect(dayKey(dec[0])).toBe('2026-11-29');
+    expect(g.every((d) => d.getHours() === 0)).toBe(true);
+  });
+
+  it('addMonths: 항상 1일, 31일 오버플로 없음', () => {
+    expect(dayKey(addMonths(new Date(2026, 0, 31), 1))).toBe('2026-02-01');
+    expect(dayKey(addMonths(new Date(2026, 0, 15), -1))).toBe('2025-12-01');
+  });
+
+  it('isSameDay', () => {
+    expect(isSameDay(new Date(2026, 10, 1, 1), new Date(2026, 10, 1, 23))).toBe(true);
+    expect(isSameDay(new Date(2026, 10, 1), new Date(2026, 10, 2))).toBe(false);
+  });
+});
