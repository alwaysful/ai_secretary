+import type { CalendarEvent } from '../types';
+import { dayKey, formatDayLong } from '../lib/date';
+import { eventsOnDay } from '../lib/events';
+import { EventRow } from './EventRow';
+
+export function Agenda({ days, events }: { days: Date[]; events: CalendarEvent[] }) {
+  const groups = days.map((d) => ({ d, list: eventsOnDay(events, d) })).filter((g) => g.list.length > 0);
+  if (groups.length === 0) return <p className="empty">이 달에는 일정이 없습니다.</p>;
+  return (
+    <div className="agenda">
+      {groups.map(({ d, list }) => (
+        <section key={dayKey(d)}>
+          <h3>{formatDayLong(d)}</h3>
+          <ul>{list.map((ev) => <EventRow key={ev.id} ev={ev} />)}</ul>
+        </section>
+      ))}
+    </div>
+  );
+}
