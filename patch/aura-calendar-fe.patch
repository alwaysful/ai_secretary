+++ b/frontend/src/App.tsx
@@ -0,0 +1,79 @@
+import { useEffect, useMemo, useState } from 'react';
+import { Agenda } from './components/Agenda';
+import { DayPanel } from './components/DayPanel';
+import { MonthGrid } from './components/MonthGrid';
+import { Toolbar } from './components/Toolbar';
+import { addDays, addMonths, monthGrid, startOfDay } from './lib/date';
+import { filterKind } from './lib/events';
+import { calendarApi } from './services/calendar-api';
+import type { CalendarEvent, Filter, View } from './types';
+
+type Status = 'loading' | 'ready' | 'error';
+
+export default function App() {
+  const today = useMemo(() => startOfDay(new Date()), []);
+  const [month, setMonth] = useState(() => addMonths(today, 0));
+  const [selected, setSelected] = useState(today);
+  const [view, setView] = useState<View>('month');
+  const [filter, setFilter] = useState<Filter>('all');
+  const [events, setEvents] = useState<CalendarEvent[]>([]);
+  const [status, setStatus] = useState<Status>('loading');
+  const [error, setError] = useState('');
+  const [reload, setReload] = useState(0);
+
+  const grid = useMemo(() => monthGrid(month), [month]);
+  const visible = useMemo(() => filterKind(events, filter), [events, filter]);
+
+  useEffect(() => {
+    const ac = new AbortController();
+    setStatus('loading');
+    calendarApi
+      .list(grid[0], addDays(grid[grid.length - 1], 1), ac.signal)
+      .then((list) => {
+        setEvents(list);
+        setStatus('ready');
+      })
+      .catch((e: unknown) => {
+        if (ac.signal.aborted) return;
+        setError(e instanceof Error ? e.message : '일정을 불러오지 못했습니다.');
+        setStatus('error');
+      });
+    return () => ac.abort();
+  }, [grid, reload]);
+
+  const goto = (m: Date) => {
+    setMonth(m);
+    setSelected(m.getFullYear() === today.getFullYear() && m.getMonth() === today.getMonth() ? today : m);
+  };
+
+  return (
+    <div className="app">
+      <Toolbar
+        month={month}
+        view={view}
+        filter={filter}
+        onPrev={() => goto(addMonths(month, -1))}
+        onNext={() => goto(addMonths(month, 1))}
+        onToday={() => goto(addMonths(today, 0))}
+        onView={setView}
+        onFilter={setFilter}
+      />
+      {status === 'error' && (
+        <p className="error" role="alert">
+          {error} <button type="button" onClick={() => setReload((n) => n + 1)}>다시 시도</button>
+        </p>
+      )}
+      {status === 'loading' && <p className="loading">불러오는 중...</p>}
+      <main className={view === 'month' ? 'layout' : 'layout layout--single'}>
+        {view === 'month' ? (
+          <>
+            <MonthGrid grid={grid} month={month} events={visible} selected={selected} today={today} onSelect={setSelected} />
+            <DayPanel day={selected} events={visible} />
+          </>
+        ) : (
+          <Agenda days={grid.filter((d) => d.getMonth() === month.getMonth())} events={visible} />
+        )}
+      </main>
+    </div>
+  );
+}
