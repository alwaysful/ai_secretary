@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest';
+import type { CalendarEvent } from '../types';
+import { classify, eventsOnDay, filterKind, safeHttpUrl } from './events';
+
+const ev = (p: Partial<CalendarEvent> & { subject: string; start: Date; end: Date }): CalendarEvent => ({
+  id: p.subject,
+  isAllDay: false,
+  categories: [],
+  ...p,
+  start: p.start.toISOString(),
+  end: p.end.toISOString(),
+});
+
+describe('events', () => {
+  it('classify: 범주/종일은 행사, 나머지는 일정', () => {
+    const t = { start: new Date(2026, 10, 10, 9), end: new Date(2026, 10, 10, 10) };
+    expect(classify(ev({ subject: 'a', ...t, categories: [' 행사 '] }))).toBe('event');
+    expect(classify(ev({ subject: 'b', ...t, categories: ['Workshop'] }))).toBe('event');
+    expect(classify(ev({ subject: 'c', ...t, isAllDay: true }))).toBe('event');
+    expect(classify(ev({ subject: 'd', ...t }))).toBe('schedule');
+  });
+
+  it('eventsOnDay: 종일 일정의 end(배타적) 날에는 안 나옴', () => {
+    const multi = ev({ subject: 'ws', isAllDay: true, start: new Date(2026, 10, 10), end: new Date(2026, 10, 12) });
+    expect(eventsOnDay([multi], new Date(2026, 10, 10))).toHaveLength(1);
+    expect(eventsOnDay([multi], new Date(2026, 10, 11))).toHaveLength(1);
+    expect(eventsOnDay([multi], new Date(2026, 10, 12))).toHaveLength(0);
+  });
+
+  it('eventsOnDay: 종일 먼저, 이후 시작 시각순', () => {
+    const late = ev({ subject: 'late', start: new Date(2026, 10, 10, 15), end: new Date(2026, 10, 10, 16) });
+    const early = ev({ subject: 'early', start: new Date(2026, 10, 10, 9), end: new Date(2026, 10, 10, 10) });
+    const all = ev({ subject: 'all', isAllDay: true, start: new Date(2026, 10, 10), end: new Date(2026, 10, 11) });
+    expect(eventsOnDay([late, early, all], new Date(2026, 10, 10)).map((e) => e.subject)).toEqual(['all', 'early', 'late']);
+  });
+
+  it('filterKind', () => {
+    const a = ev({ subject: 'a', isAllDay: true, start: new Date(2026, 10, 1), end: new Date(2026, 10, 2) });
+    const b = ev({ subject: 'b', start: new Date(2026, 10, 1, 9), end: new Date(2026, 10, 1, 10) });
+    expect(filterKind([a, b], 'event').map((e) => e.subject)).toEqual(['a']);
+    expect(filterKind([a, b], 'schedule').map((e) => e.subject)).toEqual(['b']);
+    expect(filterKind([a, b], 'all')).toHaveLength(2);
+  });
+
+  it('safeHttpUrl: http(s)만 허용', () => {
+    expect(safeHttpUrl('https://outlook.office.com/x')).toBe('https://outlook.office.com/x');
+    expect(safeHttpUrl('javascript:alert(1)')).toBeUndefined();
+    expect(safeHttpUrl('not a url')).toBeUndefined();
+    expect(safeHttpUrl(undefined)).toBeUndefined();
+  });
+});
