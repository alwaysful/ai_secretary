+import type { CalendarApi } from '../types';
+import { buildMockEvents } from './mock-data';
+
+const delay = (ms: number, signal?: AbortSignal) =>
+  new Promise<void>((resolve, reject) => {
+    const t = setTimeout(resolve, ms);
+    signal?.addEventListener('abort', () => {
+      clearTimeout(t);
+      reject(new DOMException('aborted', 'AbortError'));
+    });
+  });
+
+const mockApi: CalendarApi = {
+  async list(from, to, signal) {
+    await delay(250, signal);
+    return buildMockEvents().filter((ev) => new Date(ev.start) < to && new Date(ev.end) > from);
+  },
+};
+
+/** 백엔드 계약(미구현): GET /calendar/events?from=<ISO>&to=<ISO> → CalendarEvent[] */
+const httpApi: CalendarApi = {
+  async list(from, to, signal) {
+    const qs = new URLSearchParams({ from: from.toISOString(), to: to.toISOString() });
+    const res = await fetch(`/calendar/events?${qs}`, { signal });
+    if (!res.ok) throw new Error(`일정 조회 실패 (${res.status})`);
+    return (await res.json()) as Awaited<ReturnType<CalendarApi['list']>>;
+  },
+};
+
+export const calendarApi: CalendarApi = import.meta.env.VITE_USE_MOCK === 'false' ? httpApi : mockApi;
diff --git a/frontend/src/services/mock-data.ts b/frontend/src/services/mock-data.ts
