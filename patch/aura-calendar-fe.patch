@@ -0,0 +1,49 @@
+import type { CalendarEvent, EventKind, Filter } from '../types';
+import { addDays, formatTime, startOfDay } from './date';
+
+/** Outlook 범주에 이 단어가 있으면 '행사'. */
+const EVENT_WORDS = ['행사', '세미나', '워크숍', '컨퍼런스', 'event', 'seminar', 'workshop', 'conference'];
+
+/** 행사: 범주 지정 또는 종일 일정. 그 외는 일정. */
+export function classify(ev: CalendarEvent): EventKind {
+  if (ev.categories.some((c) => EVENT_WORDS.includes(c.trim().toLowerCase()))) return 'event';
+  return ev.isAllDay ? 'event' : 'schedule';
+}
+
+function compare(a: CalendarEvent, b: CalendarEvent): number {
+  if (a.isAllDay !== b.isAllDay) return a.isAllDay ? -1 : 1;
+  return new Date(a.start).getTime() - new Date(b.start).getTime() || a.subject.localeCompare(b.subject);
+}
+
+/** day와 겹치는 일정(여러 날 걸친 일정 포함). 종일/시간순 정렬. */
+export function eventsOnDay(events: CalendarEvent[], day: Date): CalendarEvent[] {
+  const s = startOfDay(day).getTime();
+  const e = addDays(startOfDay(day), 1).getTime();
+  return events
+    .filter((ev) => {
+      const es = new Date(ev.start).getTime();
+      const ee = new Date(ev.end).getTime();
+      return es < e && (ee > s || (ee === es && es >= s));
+    })
+    .sort(compare);
+}
+
+export function filterKind(events: CalendarEvent[], filter: Filter): CalendarEvent[] {
+  return filter === 'all' ? events : events.filter((ev) => classify(ev) === filter);
+}
+
+export function formatRange(ev: CalendarEvent): string {
+  if (ev.isAllDay) return '종일';
+  return `${formatTime(new Date(ev.start))} – ${formatTime(new Date(ev.end))}`;
+}
+
+/** 외부 데이터의 링크는 http(s)만 허용한다. */
+export function safeHttpUrl(url?: string): string | undefined {
+  if (!url) return undefined;
+  try {
+    const u = new URL(url);
+    return u.protocol === 'https:' || u.protocol === 'http:' ? u.toString() : undefined;
+  } catch {
+    return undefined;
+  }
+}
