@@ -0,0 +1,84 @@
+:root {
+  --bg: #eef1f4;
+  --panel: #ffffff;
+  --ink: #16212b;
+  --muted: #667583;
+  --line: #d6dce2;
+  --accent: #0e6f6a;
+  --accent-ink: #ffffff;
+  --user: #dff1ee;
+  --ai: #ffffff;
+  --err: #b3261e;
+  --ok: #2e8b57;
+  --warn: #c58a00;
+  color-scheme: light dark;
+  font-family: 'Pretendard', 'Noto Sans KR', 'Malgun Gothic', system-ui, sans-serif;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #10161c;
+    --panel: #18212a;
+    --ink: #e6ecf1;
+    --muted: #8d9ba8;
+    --line: #2a3541;
+    --accent: #4fb8b0;
+    --accent-ink: #08201e;
+    --user: #1c3a3a;
+    --ai: #1e2832;
+    --err: #ff8a80;
+    --ok: #5cc98a;
+    --warn: #e5b53b;
+  }
+}
+* { box-sizing: border-box; }
+html, body, #root { height: 100%; margin: 0; }
+body { background: var(--bg); color: var(--ink); font-size: 15px; line-height: 1.55; }
+button, textarea { font: inherit; color: inherit; }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+.app { display: grid; grid-template-columns: 280px 1fr; height: 100%; }
+.side { background: var(--panel); border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; padding: 16px; min-height: 0; }
+.brand { font-size: 22px; font-weight: 700; letter-spacing: 0.04em; }
+.convs { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; min-height: 0; }
+.conv { text-align: left; background: none; border: 0; border-radius: 6px; padding: 8px 10px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.conv:hover { background: var(--bg); }
+.conv.on { background: var(--bg); box-shadow: inset 3px 0 0 var(--accent); font-weight: 600; }
+
+.primary { background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 6px; padding: 9px 16px; cursor: pointer; font-weight: 600; }
+.primary:disabled { opacity: 0.45; cursor: default; }
+.ghost { background: none; border: 1px solid var(--line); border-radius: 6px; padding: 6px 12px; cursor: pointer; }
+.ghost:hover { background: var(--bg); }
+
+.muted { color: var(--muted); margin: 0; }
+.error { color: var(--err); margin: 0; }
+.mail { border-top: 1px solid var(--line); padding-top: 12px; display: flex; flex-direction: column; gap: 8px; font-size: 13px; }
+.mail p { margin: 0; word-break: break-all; }
+code { background: var(--bg); padding: 2px 6px; border-radius: 4px; font-weight: 700; }
+.status { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
+.dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
+.dot.ok { background: var(--ok); }
+.dot.warn { background: var(--warn); }
+.dot.down { background: var(--err); }
+
+.chat { display: flex; flex-direction: column; min-width: 0; min-height: 0; height: 100%; }
+.bar { display: flex; align-items: center; gap: 12px; padding: 12px 20px; border-bottom: 1px solid var(--line); background: var(--panel); }
+.bar h1 { font-size: 16px; margin: 0; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.menu { display: none; }
+.log { flex: 1; overflow-y: auto; padding: 24px 20px; display: flex; flex-direction: column; gap: 12px; }
+.empty { margin: auto; text-align: center; }
+.empty p:first-child { font-size: 20px; font-weight: 600; margin: 0 0 4px; }
+.msg { display: flex; max-width: 760px; width: 100%; margin: 0 auto; }
+.msg.user { justify-content: flex-end; }
+.bubble { white-space: pre-wrap; word-break: break-word; max-width: 85%; padding: 10px 14px; border-radius: 12px; border: 1px solid var(--line); background: var(--ai); }
+.msg.user .bubble { background: var(--user); border-color: transparent; }
+.banner { padding: 8px 20px; border-top: 1px solid var(--line); background: var(--panel); }
+.composer { display: flex; gap: 10px; padding: 12px 20px 16px; max-width: 800px; width: 100%; margin: 0 auto; align-items: flex-end; }
+.composer textarea { flex: 1; resize: none; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
+
+@media (max-width: 720px) {
+  .app { grid-template-columns: 1fr; }
+  .side { position: fixed; inset: 0 25% 0 0; z-index: 10; transform: translateX(-100%); transition: transform 0.2s; }
+  .side.open { transform: none; }
+  .menu { display: inline-block; }
+}
+@media (prefers-reduced-motion: reduce) { .side { transition: none; } }
