diff --git a/frontend/src/App.tsx b/frontend/src/App.tsx
new file mode 100644
index 0000000..65303a9
--- /dev/null
+++ b/frontend/src/App.tsx
@@ -0,0 +1,178 @@
+import { KeyboardEvent, useCallback, useEffect, useRef, useState } from 'react';
+import { api, Conversation, Health, Message, streamMessage } from './api';
+import { MailPanel } from './MailPanel';
+
+const tmpId = () => `tmp-${crypto.randomUUID()}`;
+const label = (c: Conversation) => c.title || '새 대화';
+
+export function App() {
+  const [convs, setConvs] = useState<Conversation[]>([]);
+  const [activeId, setActiveId] = useState<string | null>(null);
+  const [messages, setMessages] = useState<Message[]>([]);
+  const [input, setInput] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [health, setHealth] = useState<Health | null>(null);
+  const [menu, setMenu] = useState(false);
+  const abortRef = useRef<AbortController | null>(null);
+  const bottomRef = useRef<HTMLDivElement>(null);
+  const loadSeq = useRef(0);
+
+  const loadConvs = useCallback(() => api.conversations().then(setConvs).catch(() => undefined), []);
+
+  useEffect(() => {
+    void loadConvs();
+  }, [loadConvs]);
+
+  useEffect(() => {
+    const poll = () =>
+      api
+        .health()
+        .then(setHealth)
+        .catch(() => setHealth(null));
+    poll();
+    const t = setInterval(poll, 10_000);
+    return () => clearInterval(t);
+  }, []);
+
+  useEffect(() => {
+    bottomRef.current?.scrollIntoView({ block: 'end' });
+  }, [messages]);
+
+  const open = async (id: string | null) => {
+    abortRef.current?.abort();
+    setActiveId(id);
+    setError('');
+    setMenu(false);
+    const seq = ++loadSeq.current;
+    if (!id) return setMessages([]);
+    try {
+      const list = await api.messages(id);
+      if (seq === loadSeq.current) setMessages(list.filter((m) => m.role !== 'SYSTEM'));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    }
+  };
+
+  const send = async () => {
+    const content = input.trim();
+    if (!content || busy) return;
+    setInput('');
+    setError('');
+    setBusy(true);
+
+    const ac = new AbortController();
+    abortRef.current = ac;
+    const now = new Date().toISOString();
+    const aiId = tmpId();
+    let id = activeId;
+    try {
+      if (!id) {
+        const c = await api.createConversation(content.slice(0, 40));
+        id = c.id;
+        setActiveId(id);
+        setConvs((prev) => [c, ...prev]);
+      }
+      setMessages((prev) => [
+        ...prev,
+        { id: tmpId(), role: 'USER', content, createdAt: now },
+        { id: aiId, role: 'ASSISTANT', content: '', createdAt: now },
+      ]);
+      await streamMessage(
+        id,
+        content,
+        (t) => setMessages((prev) => prev.map((m) => (m.id === aiId ? { ...m, content: m.content + t } : m))),
+        ac.signal,
+      );
+    } catch (e) {
+      if (!ac.signal.aborted) setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setBusy(false);
+      abortRef.current = null;
+      void loadConvs();
+    }
+  };
+
+  const onKey = (e: KeyboardEvent<HTMLTextAreaElement>) => {
+    if (e.key === 'Enter' && !e.shiftKey && !e.nativeEvent.isComposing) {
+      e.preventDefault();
+      void send();
+    }
+  };
+
+  const modelOk = health?.model.state === 'ready' || health?.model.state === 'unloaded';
+
+  return (
+    <div className="app">
+      <aside className={menu ? 'side open' : 'side'}>
+        <div className="brand">AURA</div>
+        <button className="primary" onClick={() => void open(null)}>
+          새 대화
+        </button>
+        <nav className="convs" aria-label="대화 목록">
+          {convs.map((c) => (
+            <button key={c.id} className={c.id === activeId ? 'conv on' : 'conv'} onClick={() => void open(c.id)}>
+              {label(c)}
+            </button>
+          ))}
+          {convs.length === 0 && <p className="muted">대화 없음</p>}
+        </nav>
+        <MailPanel />
+        <div className="status" role="status">
+          <span className={health ? (health.db === 'ok' && modelOk ? 'dot ok' : 'dot warn') : 'dot down'} />
+          {health ? `DB ${health.db} · ${health.model.name} ${health.model.state}` : '백엔드 연결 안 됨'}
+        </div>
+      </aside>
+
+      <main className="chat">
+        <header className="bar">
+          <button className="ghost menu" onClick={() => setMenu((v) => !v)} aria-label="메뉴">
+            ☰
+          </button>
+          <h1>{activeId ? label(convs.find((c) => c.id === activeId) ?? ({ title: null } as Conversation)) : '새 대화'}</h1>
+        </header>
+
+        <div className="log">
+          {messages.length === 0 && (
+            <div className="empty">
+              <p>무엇을 도와줄까요?</p>
+              <p className="muted">예: &quot;안 읽은 메일 3통 요약해줘&quot;</p>
+            </div>
+          )}
+          {messages.map((m) => (
+            <div key={m.id} className={m.role === 'USER' ? 'msg user' : 'msg ai'}>
+              <div className="bubble">{m.content || (busy ? '…' : '')}</div>
+            </div>
+          ))}
+          <div ref={bottomRef} />
+        </div>
+
+        {error && (
+          <p className="error banner" role="alert">
+            {error}
+          </p>
+        )}
+
+        <div className="composer">
+          <textarea
+            value={input}
+            onChange={(e) => setInput(e.target.value)}
+            onKeyDown={onKey}
+            placeholder="메시지 입력 (Enter 전송, Shift+Enter 줄바꿈)"
+            rows={2}
+            maxLength={8000}
+          />
+          {busy ? (
+            <button className="primary" onClick={() => abortRef.current?.abort()}>
+              중지
+            </button>
+          ) : (
+            <button className="primary" onClick={() => void send()} disabled={!input.trim()}>
+              보내기
+            </button>
+          )}
+        </div>
+      </main>
+    </div>
+  );
+}
diff --git a/frontend/src/MailPanel.tsx b/frontend/src/MailPanel.tsx
new file mode 100644
index 0000000..80e331f
--- /dev/null
+++ b/frontend/src/MailPanel.tsx
@@ -0,0 +1,67 @@
+import { useCallback, useEffect, useState } from 'react';
+import { api, DeviceLogin, MailStatus } from './api';
+
+/** Outlook 연동 상태. device code 로그인 중에는 3초마다 상태를 확인한다. */
+export function MailPanel() {
+  const [status, setStatus] = useState<MailStatus | null>(null);
+  const [login, setLogin] = useState<DeviceLogin | null>(null);
+  const [error, setError] = useState('');
+
+  const refresh = useCallback(() => {
+    api
+      .mailStatus()
+      .then(setStatus)
+      .catch(() => setStatus(null));
+  }, []);
+
+  useEffect(refresh, [refresh]);
+
+  useEffect(() => {
+    if (!login) return;
+    const t = setInterval(refresh, 3000);
+    return () => clearInterval(t);
+  }, [login, refresh]);
+
+  useEffect(() => {
+    if (login && status?.connected) setLogin(null);
+  }, [login, status]);
+
+  const run = async (fn: () => Promise<void>) => {
+    setError('');
+    try {
+      await fn();
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    }
+  };
+
+  if (!status) return <p className="muted">메일 상태 확인 불가</p>;
+  if (!status.configured) return <p className="muted">Outlook 미설정. backend/README.md 참고.</p>;
+
+  return (
+    <div className="mail">
+      {status.connected ? (
+        <>
+          <p>
+            Outlook 연결됨 <span className="muted">{status.email}</span>
+          </p>
+          <button className="ghost" onClick={() => run(async () => { await api.mailDisconnect(); refresh(); })}>
+            연결 해제
+          </button>
+        </>
+      ) : login ? (
+        <p>
+          <a href={login.verificationUri} target="_blank" rel="noreferrer">
+            {login.verificationUri}
+          </a>
+          에서 코드 입력: <code>{login.userCode}</code>
+        </p>
+      ) : (
+        <button className="ghost" onClick={() => run(async () => { setLogin(await api.mailStart()); refresh(); })}>
+          Outlook 연결
+        </button>
+      )}
+      {error && <p className="error">{error}</p>}
+    </div>
+  );
+}
diff --git a/frontend/src/api.ts b/frontend/src/api.ts
new file mode 100644
index 0000000..20de303
--- /dev/null
+++ b/frontend/src/api.ts
@@ -0,0 +1,113 @@
+export interface Conversation {
+  id: string;
+  title: string | null;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Message {
+  id: string;
+  role: 'SYSTEM' | 'USER' | 'ASSISTANT';
+  content: string;
+  model?: string | null;
+  durationMs?: number | null;
+  createdAt: string;
+}
+
+export interface Health {
+  status: string;
+  db: string;
+  model: { name: string; state: string };
+}
+
+export interface MailStatus {
+  configured: boolean;
+  connected: boolean;
+  pending: boolean;
+  email: string | null;
+}
+
+export interface DeviceLogin {
+  userCode: string;
+  verificationUri: string;
+  expiresIn: number;
+}
+
+const BASE = '/api';
+
+export class ApiError extends Error {
+  constructor(
+    public readonly status: number,
+    message: string,
+  ) {
+    super(message);
+    this.name = 'ApiError';
+  }
+}
+
+async function failure(res: Response): Promise<ApiError> {
+  const body = (await res.json().catch(() => null)) as { message?: string | string[] } | null;
+  const m = body?.message;
+  return new ApiError(res.status, Array.isArray(m) ? m.join(', ') : (m ?? `HTTP ${res.status}`));
+}
+
+async function req<T>(path: string, init?: RequestInit): Promise<T> {
+  const res = await fetch(BASE + path, {
+    ...init,
+    headers: init?.body ? { 'Content-Type': 'application/json' } : undefined,
+  });
+  if (!res.ok) throw await failure(res);
+  return res.status === 204 ? (undefined as T) : ((await res.json()) as T);
+}
+
+export const api = {
+  health: () => req<Health>('/health'),
+  conversations: () => req<Conversation[]>('/conversations'),
+  createConversation: (title?: string) =>
+    req<Conversation>('/conversations', { method: 'POST', body: JSON.stringify({ title }) }),
+  messages: (id: string) => req<Message[]>(`/conversations/${id}/messages`),
+  mailStatus: () => req<MailStatus>('/mail/auth/status'),
+  mailStart: () => req<DeviceLogin>('/mail/auth/start', { method: 'POST' }),
+  mailDisconnect: () => req<void>('/mail/auth', { method: 'DELETE' }),
+};
+
+/** SSE(POST)를 fetch로 읽는다. data:{"token"} → onToken, event:error → throw. */
+export async function streamMessage(
+  id: string,
+  content: string,
+  onToken: (t: string) => void,
+  signal: AbortSignal,
+): Promise<void> {
+  const res = await fetch(`${BASE}/conversations/${id}/messages/stream`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ content }),
+    signal,
+  });
+  if (!res.ok || !res.body) throw await failure(res);
+
+  const reader = res.body.getReader();
+  const decoder = new TextDecoder();
+  let buf = '';
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    buf += decoder.decode(value, { stream: true });
+    let sep: number;
+    while ((sep = buf.indexOf('\n\n')) >= 0) {
+      const block = buf.slice(0, sep);
+      buf = buf.slice(sep + 2);
+      let event = 'message';
+      let data = '';
+      for (const line of block.split('\n')) {
+        if (line.startsWith('event:')) event = line.slice(6).trim();
+        else if (line.startsWith('data:')) data += line.slice(5).trim();
+      }
+      if (!data) continue;
+      const parsed = JSON.parse(data) as { token?: string; message?: string };
+      if (event === 'error') throw new Error(parsed.message ?? 'stream error');
+      if (event === 'done') return;
+      if (parsed.token) onToken(parsed.token);
+    }
+  }
+}
