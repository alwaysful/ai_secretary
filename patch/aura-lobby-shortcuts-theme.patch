+            </tr>
+            <tr className="group">
+              <td colSpan={2}>채팅</td>
+            </tr>
+            {CHAT_KEYS.map(([k, label]) => (
+              <tr key={k}>
+                <td>
+                  <kbd>{k}</kbd>
+                </td>
+                <td>{label}</td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </div>
+  );
+}
