+import { NotFoundException } from '@nestjs/common';
+import { MemoryService } from '../../src/memory/memory.service';
+
+function make() {
+  const prisma: any = {
+    memory: {
+      create: jest.fn().mockResolvedValue({ id: '1' }),
+      findMany: jest.fn().mockResolvedValue([]),
+      findUnique: jest.fn().mockResolvedValue({ id: '1' }),
+      updateMany: jest.fn().mockResolvedValue({ count: 1 }),
+      deleteMany: jest.fn().mockResolvedValue({ count: 1 }),
+    },
+  };
+  return { prisma, svc: new MemoryService(prisma) };
+}
+
+describe('MemoryService', () => {
+  it('create: kind/content 저장', async () => {
+    const { svc, prisma } = make();
+    await svc.create({ kind: 'PREFERENCE' as any, content: '짧게 답해' });
+    expect(prisma.memory.create).toHaveBeenCalledWith({ data: { kind: 'PREFERENCE', content: '짧게 답해' } });
+  });
+
+  it('recent: 최신순 limit', async () => {
+    const { svc, prisma } = make();
+    await svc.recent(7);
+    expect(prisma.memory.findMany).toHaveBeenCalledWith({ orderBy: { updatedAt: 'desc' }, take: 7 });
+  });
+
+  it('update/remove: 없으면 404', async () => {
+    const { svc, prisma } = make();
+    prisma.memory.updateMany.mockResolvedValue({ count: 0 });
+    prisma.memory.deleteMany.mockResolvedValue({ count: 0 });
+    await expect(svc.update('x', { content: 'a' })).rejects.toBeInstanceOf(NotFoundException);
+    await expect(svc.remove('x')).rejects.toBeInstanceOf(NotFoundException);
+  });
+});
