@@ -0,0 +1,32 @@
+import { Injectable, NotFoundException } from '@nestjs/common';
+import { MemoryKind } from '@prisma/client';
+import { PrismaService } from '../prisma/prisma.service';
+import { CreateMemoryDto, UpdateMemoryDto } from './memory.dto';
+
+@Injectable()
+export class MemoryService {
+  constructor(private readonly prisma: PrismaService) {}
+
+  create(dto: CreateMemoryDto) {
+    return this.prisma.memory.create({ data: { kind: dto.kind, content: dto.content } });
+  }
+
+  list(kind?: MemoryKind) {
+    return this.prisma.memory.findMany({ where: { kind }, orderBy: { updatedAt: 'desc' }, take: 200 });
+  }
+
+  recent(limit: number) {
+    return this.prisma.memory.findMany({ orderBy: { updatedAt: 'desc' }, take: limit });
+  }
+
+  async update(id: string, dto: UpdateMemoryDto) {
+    const r = await this.prisma.memory.updateMany({ where: { id }, data: { kind: dto.kind, content: dto.content } });
+    if (r.count === 0) throw new NotFoundException(`memory ${id} not found`);
+    return this.prisma.memory.findUnique({ where: { id } });
+  }
+
+  async remove(id: string): Promise<void> {
+    const r = await this.prisma.memory.deleteMany({ where: { id } });
+    if (r.count === 0) throw new NotFoundException(`memory ${id} not found`);
+  }
+}
