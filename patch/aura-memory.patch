+import { Injectable } from '@nestjs/common';
+import { escapeTags } from '../../common/text';
+import { MemoryService } from '../../memory/memory.service';
+import { ContextTool } from './tool';
+
+const LIMIT = 20;
+const LABEL: Record<string, string> = { PREFERENCE: '선호', FACT: '사실', PROJECT: '프로젝트' };
+
+/** 저장된 기억을 매 요청마다 프롬프트에 주입한다. 읽기 전용. 기억 없으면 빈 문자열. */
+@Injectable()
+export class MemoryTool implements ContextTool {
+  readonly name = 'memory';
+  readonly readOnly = true as const;
+
+  constructor(private readonly memory: MemoryService) {}
+
+  matches(): boolean {
+    return true;
+  }
+
+  async run(): Promise<string> {
+    const rows = await this.memory.recent(LIMIT);
+    if (rows.length === 0) return '';
+    const lines = rows.map((m) => {
+      const text = escapeTags(m.content).replace(/\s*\n\s*/g, ' ');
+      return `- [${LABEL[m.kind] ?? m.kind}] ${text} (${m.updatedAt.toISOString().slice(0, 10)})`;
+    });
+    return ['사용자가 직접 저장한 기억. 오래됐거나 서로 상충할 수 있으니 단정하지 않는다.', ...lines].join('\n');
+  }
+}
