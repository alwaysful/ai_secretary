--- /dev/null
+++ b/backend/src/memory/memory.controller.ts
@@ -0,0 +1,43 @@
+import {
+  Body,
+  Controller,
+  Delete,
+  Get,
+  HttpCode,
+  Param,
+  ParseEnumPipe,
+  ParseUUIDPipe,
+  Patch,
+  Post,
+  Query,
+} from '@nestjs/common';
+import { MemoryKind } from '@prisma/client';
+import { CreateMemoryDto, UpdateMemoryDto } from './memory.dto';
+import { MemoryService } from './memory.service';
+
+/** 인증 없음: HOST=127.0.0.1 유지. */
+@Controller('memories')
+export class MemoryController {
+  constructor(private readonly memory: MemoryService) {}
+
+  @Post()
+  create(@Body() dto: CreateMemoryDto) {
+    return this.memory.create(dto);
+  }
+
+  @Get()
+  list(@Query('kind', new ParseEnumPipe(MemoryKind, { optional: true })) kind?: MemoryKind) {
+    return this.memory.list(kind);
+  }
+
+  @Patch(':id')
+  update(@Param('id', ParseUUIDPipe) id: string, @Body() dto: UpdateMemoryDto) {
+    return this.memory.update(id, dto);
+  }
+
+  @Delete(':id')
+  @HttpCode(204)
+  remove(@Param('id', ParseUUIDPipe) id: string): Promise<void> {
+    return this.memory.remove(id);
+  }
+}
