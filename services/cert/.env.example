# 자격증 서비스 (AURA 백엔드가 이 주소로 호출)
CERT_PORT=3100
CERT_HOST=127.0.0.1
# 자체 DB (docker-compose.yml, 포트 5433). 없으면 시작 때 자동 생성
CERT_DATABASE_URL=postgresql://cert:cert@127.0.0.1:5433/aura_cert?schema=public
# 공공데이터포털 키. 비우면 ../../backend/.env 의 QNET_API_KEY 사용, 화면에서 넣은 키가 우선
# QNET_API_KEY=
# 첫 실행 때 옛 AURA DB의 자격증 자료 가져오기 (비우면 backend/.env DATABASE_URL)
# CERT_LEGACY_DATABASE_URL=
